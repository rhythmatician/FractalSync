#version 430

layout (local_size_x = LOCAL_SIZE, local_size_y = LOCAL_SIZE) in;

// Output DEM values (float) via SSBO binding = 0
// Sentinel values written by the shader:
//   -2.0 -> interior / did not escape
//   -1.0 -> failure / unstable (e.g., |dz| too small)
//   >0.0 -> computed DEM distance (plane units)
layout(std430, binding = 0) buffer OutDEM {
    float dem[];
} outDEM;

// Uniforms
uniform int  u_tile_w;
uniform int  u_tile_h;
uniform int  u_tile_x0;
uniform int  u_tile_y0;
uniform int  u_res;

uniform double u_xmin;
uniform double u_xmax;
uniform double u_ymin;
uniform double u_ymax;

uniform int    u_max_iter;
uniform double u_bailout2; // bailout squared
uniform double u_dem_eps;   // min |dz| threshold

// Map global pixel index -> complex c
dvec2 pixel_to_c(int gx, int gy) {
    double fx = double(gx) / double(u_res - 1);
    double fy = double(gy) / double(u_res - 1);
    double x = u_xmin + fx * (u_xmax - u_xmin);
    double y = u_ymin + fy * (u_ymax - u_ymin);
    return dvec2(x, y);
}

void main() {
    uint lx = gl_GlobalInvocationID.x;
    uint ly = gl_GlobalInvocationID.y;

    if (int(lx) >= u_tile_w || int(ly) >= u_tile_h) {
        return;
    }

    int gx = u_tile_x0 + int(lx);
    int gy = u_tile_y0 + int(ly);

    if (gx < 0 || gy < 0 || gx >= u_res || gy >= u_res) {
        return;
    }

    dvec2 c = pixel_to_c(gx, gy);

    dvec2 z = dvec2(0.0, 0.0);
    dvec2 dz = dvec2(1.0, 0.0);

    bool escaped = false;
    double absz = 0.0;

    for (int i = 0; i < u_max_iter; i++) {
        // dz_{n+1} = 2*z_n*dz_n + 1
        // complex mul: (a+bi)*(c+di) = (ac-bd) + (ad+bc)i
        double a = z.x;
        double b = z.y;
        double dax = (2.0 * (a * dz.x - b * dz.y));
        double day = (2.0 * (a * dz.y + b * dz.x));
        dz = dvec2(dax + 1.0, day + 0.0);

        // z_{n+1} = z_n^2 + c
        double aa = a * a;
        double bb = b * b;
        double twoab = 2.0 * a * b;
        z = dvec2(aa - bb + c.x, twoab + c.y);

        absz = sqrt(z.x * z.x + z.y * z.y);
        double r2 = z.x * z.x + z.y * z.y;
        if (r2 > u_bailout2) {
            escaped = true;
            break;
        }
    }

    uint idx = ly * uint(u_tile_w) + lx;

    if (!escaped) {
        // interior
        outDEM.dem[idx] = -2.0;
        return;
    }

    double absdz = sqrt(dz.x * dz.x + dz.y * dz.y);
    if (absdz < u_dem_eps || absdz == 0.0) {
        outDEM.dem[idx] = -1.0; // failure
        return;
    }

    // compute de = 2 * |z| * ln(|z|) / |dz| using float math for portability
    float absz_f = float(absz);
    float absdz_f = float(absdz);
    if (absz_f <= 0.0 || absdz_f <= 0.0) {
        outDEM.dem[idx] = -1.0; // failure
        return;
    }
    float de_f = 2.0 * absz_f * log(absz_f) / absdz_f;
    // check NaN or non-positive
    if (!(de_f > 0.0) || de_f != de_f) {
        outDEM.dem[idx] = -1.0; // failure
        return;
    }

    // Clamp to reasonable float range
    if (de_f > 1e30) {
        outDEM.dem[idx] = 1e30;
    } else {
        outDEM.dem[idx] = de_f;
    }
}
