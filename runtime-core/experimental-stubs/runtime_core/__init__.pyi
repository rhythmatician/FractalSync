# Additional runtime_core surface in builds with experimental-operational-field.
class BoundedOperationalRollout:
    @staticmethod
    def asset_field_id(asset: bytes) -> str: ...
    def __init__(self, asset: bytes, reference_policy: str, d_ref: float, epsilon: float, lambda_sq: float, kappa: float, mu: float, dt: float, beta: float) -> None: ...
    def field_id(self) -> str: ...
    def physics_profile_id(self) -> str: ...
    def probe(self, x: float, y: float) -> str: ...
    def start(self, x: float, y: float, vx: float, vy: float) -> str: ...
    def step(self, qx: float, qy: float) -> str: ...
    def state(self) -> str: ...
