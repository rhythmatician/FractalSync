+#[cfg(test)] mod stencil_reuse_tests {
+ use super::*;
+ #[test] fn expanded_source_equals_canonical_nodal_values_and_intervals() {
+  for (c,k) in [(Complex64::new(0.4,0.05),13),
+                (Complex64::new(0.36340742428278627,0.05860532738425128),17)] {
+   let Ok((tile,true,true))=contained_stencil_tile(c,k) else {panic!("expanded stable stencil");};
+   let mut checked=0;
+   for point in distance_stencil(c,dyadic_h(k)) {
+    if bounded_component_sample(point).is_some(){continue;}
+    let Some(borrowed)=canonical_sample_from_tile(point,c,k,&tile) else {continue;};
+    let expected=field_node(point,k).expect("same-root canonical point search");
+    assert_eq!(borrowed.value.to_bits(),expected.value.to_bits());
+    let a=borrowed.enclosure.unwrap();let b=expected.enclosure.unwrap();
+    assert_eq!([a.lo.to_bits(),a.hi.to_bits()],[b.lo.to_bits(),b.hi.to_bits()]);checked+=1;
+   }
+   assert!(checked>0);
+   eprintln!("[STENCIL_REUSE145] q={c:?} k={k} checked={checked}");
+  }
+ }
+}
