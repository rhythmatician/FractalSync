@@ -0,0 +1,78 @@
+//! Pure certificate memo. Quantized values are solver seeds, never proof bounds.
+use super::{certify_auto,Certificate,C};
+use super::super::super::LruCache;
+use once_cell::sync::Lazy;
+use std::sync::{RwLock,atomic::{AtomicUsize,Ordering}};
+
+type Key=[u64;8];
+type Cache=RwLock<LruCache<Key,Option<Certificate>>>;
+static CACHE:Lazy<Cache>=Lazy::new(||RwLock::new(LruCache::new(8192)));
+static HITS:AtomicUsize=AtomicUsize::new(0);
+static MISSES:AtomicUsize=AtomicUsize::new(0);
+
+fn seed(value:f64)->f64 {
+    // Retain 40 significand fraction bits. Re-solving and strict outward
+    // certification follow this operation even when the cache is disabled.
+    f64::from_bits((value.to_bits()+(1<<11))&!((1<<12)-1))
+}
+fn key(z:C,c:C,mu:C,period:usize,radius:f64)->Option<Key> {
+    if ![z,c,mu].into_iter().all(super::finite)||period==0||period>512||!radius.is_finite()||radius<0. {
+        return None;
+    }
+    let z=C::new(seed(z.re),seed(z.im));let c=C::new(seed(c.re),seed(c.im));
+    if ![z,c].into_iter().all(super::finite){return None;}
+    Some([period as u64,z.re.to_bits(),z.im.to_bits(),c.re.to_bits(),c.im.to_bits(),mu.re.to_bits(),mu.im.to_bits(),radius.to_bits()])
+}
+fn uncached(key:Key)->Option<Certificate> {
+    let c64=|i|C::new(f64::from_bits(key[i]),f64::from_bits(key[i+1]));
+    let period=usize::try_from(key[0]).ok()?;let mu=c64(5);
+    let (z,c)=super::super::solve(c64(1),c64(3),period,mu)?;
+    certify_auto(z,c,mu,period,f64::from_bits(key[7])).map(|(proof,_)|proof)
+}
+fn using(cache:&Cache,key:Key)->Option<Certificate> {
+    if let Ok(mut retained)=cache.write(){if let Some(result)=retained.get(&key){
+        HITS.fetch_add(1,Ordering::Relaxed);return result;
+    }}
+    MISSES.fetch_add(1,Ordering::Relaxed);
+    let result=uncached(key);
+    if let Ok(mut retained)=cache.write(){retained.insert(key,result);}
+    result
+}
+pub(super) fn certify(z:C,c:C,mu:C,period:usize,radius:f64)->Option<Certificate> {
+    using(&CACHE,key(z,c,mu,period,radius)?)
+}
+#[cfg(test)] pub(super) fn stats()->(usize,usize) {
+    (HITS.load(Ordering::Relaxed),MISSES.load(Ordering::Relaxed))
+}
+
+#[cfg(test)] mod tests {
+    use super::*;
+    #[test] fn cache_order_and_eviction_preserve_every_certificate_field() {
+        let cache=RwLock::new(LruCache::new(2));
+        let keys=[-0.234,-0.334,-0.434].map(|x|{
+            let mu=C::new(x,0.456);let z=mu*0.5;let c=z-mu*mu*0.25;
+            key(z,c,mu,1,0.0001).unwrap()
+        });
+        let expected=keys.map(|key|format!("{:?}",uncached(key).unwrap()));
+        for i in [0,1,2,0,2,1,0]{
+            assert_eq!(format!("{:?}",using(&cache,keys[i]).unwrap()),expected[i]);
+            assert!(cache.read().unwrap().map.len()<=2);
+        }
+    }
+    #[test] fn solver_seed_quantization_never_replaces_strict_certification() {
+        let mu=C::new(-0.234,0.456);let z=mu*0.5;let c=z-mu*mu*0.25;
+        let first=key(z,c,mu,1,0.0001).unwrap();
+        let adjacent=key(C::new(z.re.next_up(),z.im),C::new(c.re,c.im.next_down()),mu,1,0.0001).unwrap();
+        assert_eq!(first,adjacent);
+        let proof=uncached(first).unwrap();
+        for offset in [C::new(0.,0.),C::new(1e-5,0.),C::new(0.,-1e-5)] {
+            let m=mu+offset;let expected=[m*0.5,m*0.5-m*m*0.25];
+            let enclosure=proof.at(m).unwrap();
+            for i in 0..2{assert!((expected[i]-enclosure[i].0).norm()<=enclosure[i].1);}
+        }
+        assert!(certify(z,c,mu,0,0.0001).is_none());
+        assert!(certify(z,c,mu,1,f64::NAN).is_none());
+        assert!(certify(z,c,mu,1,-1.).is_none());
+        assert!(certify(C::new(f64::NAN,0.),c,mu,1,0.0001).is_none());
+    }
+}
