+ #[test] fn shoreline_lookahead_replaces_a_disagreeing_coarse_model() {
+  let zero=FieldJet::constant(0.);let epsilon=1e-4;
+  let coarse=jet(0.04,1e-7);
+  let mut field=FieldHierarchy::new(&coarse,epsilon,true,zero);
+  field.models[0].source=LevelSource::Shore;
+  for d in [0.04,0.035] {
+   let next=jet(d,1e-8);
+   field.advance_enclosed_source(&next,epsilon,true,zero,f64::INFINITY,
+    RangeJet::exact(next.d,next.grad_d,next.hessian_d),LevelSource::Shore);
+  }
+  assert!(!field.closed);
+  for _ in 0..3 {
+   let next=jet(0.035,1e-9);
