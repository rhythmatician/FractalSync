+#[cfg(test)] mod unresolved_scalar_tests {
+ use super::*;
+ #[test] fn missing_first_derivative_stencil_keeps_contained_scalar() {
+  let jet=query_scale_aware(Complex64::new(0.3226806640625,0.05),1e-4).unwrap();
+  assert!(jet.d.is_finite());
