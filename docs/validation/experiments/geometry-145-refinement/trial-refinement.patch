+}
+type ExteriorCache=std::sync::RwLock<super::LruCache<(u64,u64),bool>>;
+fn certified_exterior_using(cache:&ExteriorCache,query:C)->bool {
+    let key=(query.re.to_bits(),query.im.to_bits());
+    if let Ok(mut retained)=cache.write(){if let Some(value)=retained.get(&key){return value;}}
+    let proved=certified_exterior_uncached(query);
+    if let Ok(mut retained)=cache.write(){retained.insert(key,proved);}
+    proved
+}
+fn certified_exterior_uncached(query:C)->bool {
+    if fast_escape::escape([query.re,query.im],32768).is_some() {
+        return true;
+    }
+    for precision in [128,256,512] {
+        match point_proof::membership([query.re,query.im],precision,32768) {
+            Some(point_proof::MembershipProof::Outside(_))=>return true,
+            Some(point_proof::MembershipProof::Inside{..})=>return false,
+            None=>{}
+        }
+    }
+    false
