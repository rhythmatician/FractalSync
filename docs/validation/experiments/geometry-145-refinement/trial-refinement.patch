+#[derive(Debug)]
+enum StepFailure {
+    Geometry(String),
+    Fatal(String),
+}
+impl StepFailure {
+    fn message(self) -> String {
+        match self { Self::Geometry(message) | Self::Fatal(message) => message }
+    }
+}
+
+fn require_stage_geometry(c: Complex64, config: &ManifoldConfig) -> Result<(), StepFailure> {
+    use crate::geometry_provider::GeometryValidity;
+    let radius_squared = c.norm_sqr();
+    if !radius_squared.is_finite() || radius_squared >= 4. {
+        return Err(StepFailure::Fatal(format!(
+            "Hard invariant violated: intermediate |c|^2 = {radius_squared}; rejecting invalid stage"
+        )));
+    }
+    let jet = geometry_jet(c, config).map_err(StepFailure::Fatal)?;
+    if jet.validity == GeometryValidity::Regular
+        || (jet.is_bridge && jet.validity != GeometryValidity::ProviderFailure) {
+        return Ok(());
+    }
+    let message = geometry_refusal(c, &jet);
+    if matches!(jet.validity, GeometryValidity::Unresolved | GeometryValidity::Singular) {
+        Err(StepFailure::Geometry(message))
+    } else {
+        Err(StepFailure::Fatal(message))
+    }
+}
+
+fn advance_regular(
+    state: PhaseState,
+    dt: f64,
+    remaining: u32,
+    derivative: &impl Fn(PhaseState) -> Result<PhaseState, StepFailure>,
+    validate: &impl Fn(PhaseState) -> Result<(), StepFailure>,
+) -> Result<PhaseState, StepFailure> {
+    // An unresolved initial state cannot be repaired by changing the timestep.
+    let a = derivative(state)?;
+    let shifted = |stage: PhaseState, step: f64| -> PhaseState {
+        std::array::from_fn(|i| state[i] + step * stage[i])
+    };
+    let trial = (|| {
+        let b = derivative(shifted(a, dt * 0.5))?;
+        let c = derivative(shifted(b, dt * 0.5))?;
+        let d = derivative(shifted(c, dt))?;
+        let next = std::array::from_fn(|i| {
+            state[i] + dt * (a[i] + 2. * b[i] + 2. * c[i] + d[i]) / 6.
+        });
+        validate(next)?;
+        Ok(next)
+    })();
+    match trial {
+        Err(StepFailure::Geometry(_)) if remaining > 0 => {
+            // Both halves are local values. A failed half rejects the entire
+            // requested step; no partial movement or ledger is committed.
+            let middle = advance_regular(state, dt * 0.5, remaining - 1, derivative, validate)?;
+            advance_regular(middle, dt * 0.5, remaining - 1, derivative, validate)
+        }
+        result => result,
+    }
+}
