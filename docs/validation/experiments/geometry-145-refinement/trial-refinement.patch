@@ -0,0 +1,67 @@
+//! Exact storage of generated empty tiles, including every uncertainty flag.
+use super::{ShoreTile,DYADIC_TILE_NODES};
+
+const NODE_COUNT:usize=DYADIC_TILE_NODES*DYADIC_TILE_NODES;
+const WORD_COUNT:usize=NODE_COUNT.div_ceil(64);
+
+#[derive(Clone)]
+pub(super) struct CompressedEmptyTile {
+    k:u32,
+    h:f64,
+    origin:[f64;2],
+    unstable:[u64;WORD_COUNT],
+}
+impl CompressedEmptyTile {
+    pub(super) fn from_tile(tile:&ShoreTile)->Option<Self> {
+        if !tile.segments.is_empty()||!tile.h.is_finite()||tile.h<=0.
+            ||![tile.origin_re,tile.origin_im].iter().all(|v|v.is_finite()){return None;}
+        let mut result=Self{k:tile.k,h:tile.h,origin:[tile.origin_re,tile.origin_im],unstable:[0;WORD_COUNT]};
+        let mut previous=None;
+        for &(x,y) in &tile.unstable_nodes {
+            let ix=(x-tile.origin_re)/tile.h;let iy=(y-tile.origin_im)/tile.h;
+            if ![ix,iy].iter().all(|v|v.is_finite()&&*v>=0.&&*v<DYADIC_TILE_NODES as f64&&v.fract()==0.){return None;}
+            let index=iy as usize*DYADIC_TILE_NODES+ix as usize;
+            if previous.is_some_and(|p|index<=p)||result.point(index)!=(x,y){return None;}
+            result.unstable[index/64]|=1u64<<(index%64);
+            previous=Some(index);
+        }
+        Some(result)
+    }
+    fn point(&self,index:usize)->(f64,f64) {
+        (self.origin[0]+(index%DYADIC_TILE_NODES) as f64*self.h,
+         self.origin[1]+(index/DYADIC_TILE_NODES) as f64*self.h)
+    }
+    pub(super) fn expand(&self)->ShoreTile {
+        ShoreTile{k:self.k,h:self.h,origin_re:self.origin[0],origin_im:self.origin[1],segments:Vec::new(),
+            unstable_nodes:(0..NODE_COUNT).filter(|i|self.unstable[i/64]&(1u64<<(i%64))!=0)
+                .map(|i|self.point(i)).collect()}
+    }
+}
+
+#[cfg(test)] mod tests {
+    use super::*;
+    #[test] fn exact_roundtrip_keeps_full_and_sparse_uncertainty_masks() {
+        for k in [0,17,24,32] {
+            let h=super::super::dyadic_h(k);
+            let mut tile=ShoreTile{k,h,origin_re:170.*h,origin_im:-231.*h,segments:Vec::new(),unstable_nodes:Vec::new()};
+            let points:Vec<_>=(0..NODE_COUNT).map(|i|(tile.origin_re+(i%DYADIC_TILE_NODES) as f64*h,
+                tile.origin_im+(i/DYADIC_TILE_NODES) as f64*h)).collect();
+            for mask in [Vec::new(),points.iter().step_by(17).copied().collect(),points.clone()] {
+                tile.unstable_nodes=mask;
+                let compressed=CompressedEmptyTile::from_tile(&tile).unwrap();
+                assert_eq!(format!("{tile:?}"),format!("{:?}",compressed.expand()));
+            }
+        }
+        assert!(std::mem::size_of::<CompressedEmptyTile>()<=448);
+    }
+    #[test] fn unsupported_order_or_coordinates_use_the_original_storage() {
+        let mut tile=ShoreTile{k:0,h:0.125,origin_re:0.,origin_im:0.,segments:Vec::new(),unstable_nodes:vec![(0.0625,0.)]};
+        assert!(CompressedEmptyTile::from_tile(&tile).is_none());
+        tile.unstable_nodes=vec![(0.125,0.),(0.,0.)];
+        assert!(CompressedEmptyTile::from_tile(&tile).is_none());
+        tile.unstable_nodes=vec![(0.,0.),(0.,0.)];
+        assert!(CompressedEmptyTile::from_tile(&tile).is_none());
+        tile.unstable_nodes=vec![(f64::NAN,0.)];
+        assert!(CompressedEmptyTile::from_tile(&tile).is_none());
+    }
+}
