+// Only a directed escape certificate resolves a terminal exterior label.
+// Failed proofs and proved interior points leave the uncertainty mask intact.
+pub(super) fn certified_exterior(query:C)->bool {
+    static CACHE: once_cell::sync::Lazy<std::sync::RwLock<super::LruCache<(u64,u64),bool>>> =
+        once_cell::sync::Lazy::new(||std::sync::RwLock::new(super::LruCache::new(4096)));
