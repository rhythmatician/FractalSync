index 0000000..e8d82d9
--- /dev/null
+++ b/runtime-core/src/geometry_provider/source_tiles.rs
@@ -0,0 +1,175 @@
+//! Coordinate-owned scalar sources and bounded complete contour covers.
+use super::*;
+use std::sync::Arc;
+
+const CAPACITY:usize=64;
+type Covers=RwLock<LruCache<TileKey,Option<Arc<ShoreTile>>>>;
+static COVERS:Lazy<Covers>=Lazy::new(||RwLock::new(LruCache::new(CAPACITY)));
+
+pub(super) fn floor(epsilon:f64)->u32 {
+    let target=DYADIC_FIT_ERROR_FACTOR*GEOMETRY_SCALE_ALPHA*epsilon/
+        (DYADIC_STABILITY_BAND_CELLS as f64*2f64.sqrt());
+    let mut k=0;
+    while k<32&&dyadic_h(k)>target {k+=1;}
+    k
+}
+fn key(c:Complex64,k:u32)->TileKey {
+    let h=dyadic_h(k);
+    let (ix,iy,_,_)=dyadic_tile_origin(c,h);
+    let stride=(DYADIC_TILE_CELLS/DYADIC_CORE_CELLS) as i64;
+    let center=(DYADIC_HALO_CELLS/DYADIC_CORE_CELLS) as i64;
+    TileKey{version:GEOMETRY_PROVIDER_VERSION.into(),k,
+        tile_x:(ix+center).div_euclid(stride)*stride,
+        tile_y:(iy+center).div_euclid(stride)*stride,budget:dyadic_n0(k)}
+}
+fn sorted(tile:&mut ShoreTile) {
+    tile.segments.sort_by(|a,b| {
+        [a.p1.0,a.p1.1,a.p2.0,a.p2.1,a.normal.0,a.normal.1].iter()
+            .zip([b.p1.0,b.p1.1,b.p2.0,b.p2.1,b.normal.0,b.normal.1])
+            .map(|(a,b)|a.total_cmp(&b)).find(|order|!order.is_eq()).unwrap_or(std::cmp::Ordering::Equal)
+    });
+}
+fn build(key:&TileKey)->Option<Arc<ShoreTile>> {
+    let h=dyadic_h(key.k);
+    let half_core=DYADIC_CORE_CELLS as f64*0.5;
+    let center=Complex64::new((key.tile_x as f64*DYADIC_CORE_CELLS as f64+half_core)*h,
+        (key.tile_y as f64*DYADIC_CORE_CELLS as f64+half_core)*h);
+    // Every point in this source root is within half a tile diagonal. A first
+    // contour leaf can overestimate distance by one full diagonal. Include
+    // both query displacements, the original padding, and rounding slack.
+    // The source tree and leaf grid are identical for every point in the root;
+    // each canonical point search visits a subset of this complete search.
+    let padding=(2.*DYADIC_TILE_CELLS as f64+10.)*2f64.sqrt()+6.;
+    let (mut tile,_,spare_visit)=contained_tile_with_padding(center,key.k,padding).ok()?;
+    if !spare_visit {return None;}
+    sorted(&mut tile);
+    Some(Arc::new(tile))
+}
+fn cover(cache:&Covers,key:&TileKey)->Option<Arc<ShoreTile>> {
+    if let Ok(mut retained)=cache.write(){if let Some(value)=retained.get(key){return value;}}
+    let value=build(key);
+    if let Ok(mut retained)=cache.write(){retained.insert(key.clone(),value.clone());}
+    value
+}
+fn from_cover(c:Complex64,tile:&ShoreTile)->Option<NodalSample> {
+    let cells=(2*FIELD_SEARCH_RADIUS+1) as usize*DYADIC_TILE_CELLS;
+    if !contour_footprint_contains(c,tile,cells){return None;}
+    if !point_membership_certified(c,tile){return uncertain_sample(c,tile);}
+    shore_nodal_sample(c,tile.h,&tile.segments)
+}
+// An uncertainty mask permits contour changes only in cells touching masked
+// nodes. A segment outside every enlarged masked-cell box persists under all
+// such changes, and therefore bounds unsigned distance from above. Sign is
+// deliberately unresolved. This encloses the finite contour family; it does
+// not assert exact Mandelbrot membership or authorize a Regular query.
+fn uncertain_sample(c:Complex64,tile:&ShoreTile)->Option<NodalSample> {
+    let cells=(2*FIELD_SEARCH_RADIUS+1) as usize*DYADIC_TILE_CELLS;
+    if !contour_footprint_contains(c,tile,cells) {return None;}
+    let stable:Vec<_>=tile.segments.iter().filter(|segment| {
+        tile.unstable_nodes.iter().all(|&(x,y)| {
+            let margin=DYADIC_STABILITY_BAND_CELLS as f64*tile.h;
+            x<segment.p1.0.min(segment.p2.0)-margin
+                ||x>segment.p1.0.max(segment.p2.0)+margin
+                ||y<segment.p1.1.min(segment.p2.1)-margin
+                ||y>segment.p1.1.max(segment.p2.1)+margin
+        })
+    }).cloned().collect();
+    let upper=shore_nodal_sample(c,tile.h,&stable)?.enclosure?.abs_upper();
+    let nominal=shore_nodal_sample(c,tile.h,&tile.segments)?;
+    NodalSample::enclosed(c,nominal.value,BoundaryInterval{lo:-upper,hi:upper})
+}
+fn canonical(c:Complex64,k:u32)->Option<NodalSample> {
+    let (mut tile,_)=contained_tile(c,k).ok()?;
+    sorted(&mut tile);
+    from_cover(c,&tile)
+}
+pub(super) fn sample(c:Complex64,k:u32,epsilon:f64)->Option<NodalSample> {
+    if let Some(value)=bounded_component_sample(c){return Some(value);}
+    if !epsilon.is_finite()||epsilon<=0. {return None;}
+    let first=k.max((k+4).min(floor(epsilon)));
+    let cache_key=(k,first,c.re.to_bits(),c.im.to_bits());
+    if let Ok(mut retained)=FIELD_NODE_CACHE.write(){if let Some(value)=retained.get(&cache_key){return Some(value);}}
+    let mut uncertain=None;
+    for q in first..=(k+8).min(32) {
+        let key=key(c,q);
+        let value=match cover(&COVERS,&key) {
+            Some(tile)=>{
+                let exact=from_cover(c,&tile);
+                if exact.is_none() {uncertain=uncertain_sample(c,&tile).or(uncertain);}
+                exact
+            },
+            None=>canonical(c,q),
+        };
+        if let Some(value)=value {
+            if let Ok(mut retained)=FIELD_NODE_CACHE.write(){retained.insert(cache_key,value);}
+            return Some(value);
+        }
+    }
+    #[cfg(test)]
+    eprintln!("[SOURCE_MISSING145] point=({:.17},{:.17}) k={k} first={first}",c.re,c.im);
+    if let Some(value)=uncertain {
+        if let Ok(mut retained)=FIELD_NODE_CACHE.write(){retained.insert(cache_key,value);}
+        return Some(value);
+    }
+    None
+}
+
+#[cfg(test)] mod tests {
+    use super::*;
+    fn equal(a:Option<NodalSample>,b:Option<NodalSample>) {
+        assert_eq!(a.is_some(),b.is_some());
+        if let (Some(a),Some(b))=(a,b) {
+            assert_eq!(a.query,b.query);assert_eq!(a.value.to_bits(),b.value.to_bits());
+            let a=a.enclosure.unwrap();let b=b.enclosure.unwrap();
+            assert_eq!([a.lo.to_bits(),a.hi.to_bits()],[b.lo.to_bits(),b.hi.to_bits()]);
+        }
+    }
+    #[test] fn uncertain_contour_bounds_cover_both_signs_and_removed_segments() {
+        let c=Complex64::new(0.1,0.1);
+        let edge=|x:f64|Segment{p1:(x,-1.),p2:(x,1.),normal:(1.,0.)};
+        let mut tile=ShoreTile{k:10,h:0.01,origin_re:-2.,origin_im:-2.,
+            segments:vec![edge(-1.),edge(0.)],unstable_nodes:vec![(0.,0.)]};
+        let result=uncertain_sample(c,&tile).expect("persistent distant edge");
+        let interval=result.enclosure.unwrap();
+        for distance in [-1.1,-0.1,0.1,1.1] {
+            assert!(interval.lo<=distance&&distance<=interval.hi);
+        }
+        tile.segments.remove(0);
+        assert!(uncertain_sample(c,&tile).is_none(),"no surviving edge means no upper bound");
+    }
+    #[test] fn complete_root_cover_matches_every_control_point_and_interval() {
+        let point=Complex64::new(0.4,0.05);let q=13;let h=dyadic_h(q);
+        let key=key(point,q);let tile=build(&key).expect("complete source root");
+        let origin=Complex64::new((key.tile_x as f64*8.-24.)*h,(key.tile_y as f64*8.-24.)*h);
+        let mut valid=0;
+        for y in 0..9 {for x in 0..9 {
+            let point=origin+Complex64::new((x as f64+0.25)*56./9.*h,(y as f64+0.25)*56./9.*h);
+            assert_eq!(super::key(point,q),key);
+            let actual=from_cover(point,&tile);valid+=usize::from(actual.is_some());
+            equal(actual,canonical(point,q));
+        }}
+        assert!(valid>0);
+    }
+    #[test] fn source_cover_eviction_preserves_canonical_scalar_decisions() {
+        let cache=RwLock::new(LruCache::new(1));let q=13;
+        let points=[Complex64::new(0.4,0.05),Complex64::new(0.402,0.05)];
+        let expected=points.map(|p|canonical(p,q));
+        for i in [0,1,0,1,0] {
+            let tile=cover(&cache,&key(points[i],q)).expect("source cover");
+            equal(from_cover(points[i],&tile),expected[i]);
+            assert!(cache.read().unwrap().map.len()<=1);
+        }
+    }
+    #[test] fn source_mesh_is_finer_than_the_first_retained_zero_weight_grid() {
+        for epsilon in [1e-8,1e-6,1e-4,1e-3] {
+            let first=(0..=DYADIC_MAX_K).find(|&k|field_zero(FieldHierarchy::next_weight(
+                FieldJet::constant(0.),dyadic_h(k),epsilon,FieldJet::constant(0.))));
+            let Some(first)=first else {
+                assert!(FIELD_COEFFICIENT_ALPHA*epsilon<dyadic_h(DYADIC_MAX_K));
+                continue;
+            };
+            let source=first.max((first+4).min(floor(epsilon)));
+            assert!(dyadic_h(source)<=dyadic_h(first));
+        }
+    }
+}
