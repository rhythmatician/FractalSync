+//! Directed exclusion of changed cells from the nearest-feature candidate set.
+use super::*;
+
+pub(super) struct Exclusion {
+    query: Complex64,
+    h: f64,
+    limit: f64,
+}
+impl Exclusion {
+    pub(super) fn new(query: Complex64, tile: &ShoreTile) -> Option<Self> {
+        let distance = shore_nodal_sample(query, tile.h, &tile.segments)?
+            .enclosure?.abs_upper();
+        let limit = BoundaryInterval::point(distance).add(
+            BoundaryInterval::point(DYADIC_CUT_TIE_FACTOR)
+                .mul(BoundaryInterval::point(tile.h)),
+        ).hi;
+        limit.is_finite().then_some(Self { query, h: tile.h, limit })
+    }
+    pub(super) fn excludes(&self, node: Complex64) -> bool {
+        if !node.re.is_finite() || !node.im.is_finite() { return false; }
+        // A changed mesh node can only alter the four adjacent cells, all
+        // contained in this one-cell box. Marching-squares edges, bisections
+        // and ambiguous-case connections remain inside those cells.
+        let axis = |query: f64, center: f64| {
+            let difference = BoundaryInterval::point(query).sub(BoundaryInterval::point(center));
+            let absolute_lower = if difference.lo <= 0. && difference.hi >= 0. {
+                0.
+            } else { difference.lo.abs().min(difference.hi.abs()) };
+            BoundaryInterval::point(absolute_lower).sub(BoundaryInterval::point(self.h)).lo.max(0.)
+        };
+        let dx = axis(self.query.re, node.re);
+        let dy = axis(self.query.im, node.im);
+        let squared = BoundaryInterval::point(dx).square()
+            .add(BoundaryInterval::point(dy).square());
+        let lower = squared.lo.max(0.).sqrt().next_down().max(0.);
+        // Strictly exclude even the existing half-cell competing-feature
+        // band. Equality or rounding uncertainty cannot issue a certificate.
+        lower.is_finite() && lower > self.limit
+    }
+}
+
+#[cfg(test)] mod tests {
+    use super::*;
+    fn fixture(h: f64) -> ShoreTile {
+        ShoreTile {k:0,h,origin_re:-2.,origin_im:-2.,
+            segments:vec![Segment{p1:(1.,-0.1),p2:(1.,0.1),normal:(-1.,0.)}],
+            unstable_nodes:vec![]}
+    }
+    #[test] fn closer_cells_and_possible_competing_features_remain_unresolved() {
+        let proof=Exclusion::new(Complex64::new(0.,0.),&fixture(0.01)).unwrap();
+        assert!(!proof.excludes(Complex64::new(0.5,0.)));
+        assert!(!proof.excludes(Complex64::new(1.012,0.)),"outside the nearest distance but inside the tie band");
+        assert!(proof.excludes(Complex64::new(1.03,0.03)));
+    }
+    #[test] fn equality_and_adjacent_rounding_cannot_become_exclusion() {
+        let h=1./64.;
+        let proof=Exclusion::new(Complex64::new(0.,0.),&fixture(h)).unwrap();
+        let boundary=1.+(1.+DYADIC_CUT_TIE_FACTOR)*h;
+        assert!(!proof.excludes(Complex64::new(boundary,0.)));
+        assert!(!proof.excludes(Complex64::new(boundary.next_down(),0.)));
+        assert!(!proof.excludes(Complex64::new(boundary-h/128.,0.)));
+        assert!(proof.excludes(Complex64::new(boundary+h/128.,0.)));
+    }
+    #[test] fn the_recorded_fine_mask_box_cannot_reach_the_nearest_feature() {
+        let query=Complex64::new(0.32051424405315243,0.04736324864591995);
+        let h=dyadic_h(23);
+        let tile=ShoreTile {k:23,h,origin_re:0.,origin_im:0.,
+            segments:vec![Segment{p1:(query.re-1e-8,query.im-h),
+                p2:(query.re-1e-8,query.im+h),normal:(1.,0.)}],
+            unstable_nodes:vec![(0.32051418721675873,0.047363221645355225)]};
+        assert!(!point_membership_stable(query,&tile));
+        let proof=Exclusion::new(query,&tile).unwrap();
+        assert!(proof.excludes(Complex64::new(tile.unstable_nodes[0].0,tile.unstable_nodes[0].1)));
+    }
+}
