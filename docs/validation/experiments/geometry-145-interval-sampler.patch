+// Enclose the canonical represented Shore polyline oracle, not ideal-M distance.
+// Membership stability and coarse/fine contour disagreement remain separate
+// requirements. The nominal value and sign retain signed_shore_distance's
+// existing semantics; only projection arithmetic is enclosed here.
+fn shore_nodal_sample(query: Complex64, h: f64, segments: &[Segment]) -> Option<NodalSample> {
+    if !query.re.is_finite()
+        || !query.im.is_finite()
+        || !h.is_finite()
+        || h <= 0.
+        || !segments.iter().all(|s| {
+            [s.p1.0, s.p1.1, s.p2.0, s.p2.1, s.normal.0, s.normal.1]
+                .iter()
+                .all(|v| v.is_finite())
+        })
+    {
+        return None;
+    }
+    let value = signed_shore_distance(query, h, segments)?;
+    let p = BoundaryInterval::point;
+    let mut lower = f64::INFINITY;
+    let mut upper = f64::INFINITY;
+    for segment in segments {
+        let x = p(segment.p2.0).sub(p(segment.p1.0));
+        let y = p(segment.p2.1).sub(p(segment.p1.1));
+        let dx = p(query.re).sub(p(segment.p1.0));
+        let dy = p(query.im).sub(p(segment.p1.1));
+        let length = x.square().add(y.square());
+        let vx = segment.p2.0 - segment.p1.0;
+        let vy = segment.p2.1 - segment.p1.1;
+        let represented_length = vx * vx + vy * vy;
+        let (rx, ry) = if represented_length <= f64::MIN_POSITIVE {
+            (dx, dy)
+        } else {
+            if !length.finite() || length.lo <= 0. {
+                return None;
+            }
+            let t = dx.mul(x).add(dy.mul(y)).div_positive(length);
+            if !t.finite() {
+                return None;
+            }
+            let t = BoundaryInterval {
+                lo: t.lo.clamp(0., 1.),
+                hi: t.hi.clamp(0., 1.),
+            };
+            (dx.sub(t.mul(x)), dy.sub(t.mul(y)))
+        };
+        let square = rx.square().add(ry.square());
+        if !square.finite() || square.hi < 0. {
+            return None;
+        }
+        lower = lower.min(square.lo.max(0.).sqrt().next_down().max(0.));
+        upper = upper.min(square.hi.sqrt().next_up());
+    }
+    let interval = if value.is_sign_negative() {
+        BoundaryInterval {
+            lo: -upper,
+            hi: -lower,
+        }
+    } else {
+        BoundaryInterval {
+            lo: lower,
+            hi: upper,
+        }
+    };
+    NodalSample::enclosed(
+        query,
+        value,
+        BoundaryInterval {
+            lo: interval.lo.min(value),
+            hi: interval.hi.max(value),
+        },
+    )
+}
