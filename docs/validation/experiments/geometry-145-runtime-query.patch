+// Diagnostic adapter only. Unavailable proposals never become certificates.
+fn covered_query_probe(c:Complex64, epsilon:f64,k:u32)->Option<(FittedJet,bool)> {
+ let h=dyadic_h(k);
+ if distance_stencil(c,h).any(|p|periodic_boundary::propose(p).is_none()) {
+  eprintln!("[HOOK_UNAVAILABLE145] k={k}");return None;
+ }
+ let start=std::time::Instant::now();
+ let distance=periodic_boundary::propose(c)?.distance;
+ // This is a quantized request budget, never an outward proof bound.
+ let cap=f64::from_bits((distance/128.).to_bits() & (0x7ff_u64<<52));
+ let error=(epsilon/2000.).min(cap);
+ if !(error.is_finite()&&error>0.) {return None;}
+ let result=covered_level(c,epsilon,k,error);
+ eprintln!("[HOOK_ATTEMPT145] k={k} available={} elapsed_s={}",result.is_some(),start.elapsed().as_secs_f64());
+ result
+}
