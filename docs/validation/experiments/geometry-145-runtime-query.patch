+/// Bounded candidate screening only. The callback must independently prove exteriority.
+fn first_witness<T>(query:C,error:f64,proposal:&Proposal,
+    mut certify:impl FnMut(C)->Option<T>)->Option<T> {
+    let mut search=WitnessSearch::new(query,error,proposal)?;
+    for fraction in [0.25,0.5,0.75,0.95] {
+        for index in 0..81i32 {
+            let angle=if index==0 {0} else if index%2==1 {-(index+1)/2} else {index/2};
+            if let Some((point,_,_))=search.screen(fraction,angle) {return certify(point);}
+        }
+    }
+    None
+}
+
+fn witness_window<T>(query:C,error:f64,proposal:&Proposal,
+    fast:impl FnMut(C)->Option<T>,mut slow:impl FnMut(C)->Option<T>)->Option<T> {
+    first_witness(query,error,proposal,fast).or_else(|| {
+        witness_candidates(query,error)?.into_iter().find_map(|(point,_,_)|slow(point))
+    })
+}
