@@ -0,0 +1,231 @@
+//! Prototype only: outward f64 critical-orbit disks, with conservative refusal.
+use super::super::interval::Interval as I;
+use super::{point_proof::EscapeProof, C};
+
+fn norm_upper(re: I, im: I) -> f64 {
+    re.square().add(im.square()).hi.sqrt().next_up()
+}
+
+fn enclosing_exponent(radius: f64) -> Option<i32> {
+    if !radius.is_finite() || radius <= 0. {
+        return None;
+    }
+    let bits = radius.to_bits();
+    let exponent = ((bits >> 52) & 0x7ff) as i32;
+    let fraction = bits & ((1u64 << 52) - 1);
+    if exponent != 0 {
+        Some(exponent - 1023 + i32::from(fraction != 0))
+    } else {
+        let floor = 63 - fraction.leading_zeros() as i32 - 1074;
+        Some(floor + i32::from(!fraction.is_power_of_two()))
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Disk {
+    center: C,
+    radius: f64,
+}
+
+impl Disk {
+    fn proves_escape(self) -> bool {
+        let z = self.center;
+        let radius = self.radius;
+        let re = I::point(z.re);
+        let im = I::point(z.im);
+        let lower = re.square().add(im.square()).lo.max(0.).sqrt().next_down();
+        (lower - radius).next_down() > 2.
+    }
+
+    fn advance(self, c: [f64; 2]) -> Option<Self> {
+        let z = self.center;
+        let radius = self.radius;
+        if !super::finite(z)
+            || !radius.is_finite()
+            || radius < 0.
+            || !c.into_iter().all(f64::is_finite)
+        {
+            return None;
+        }
+        let re = I::point(z.re);
+        let im = I::point(z.im);
+        let exact_re = re.square().sub(im.square()).add(I::point(c[0]));
+        let exact_im = I::point(2.).mul(re).mul(im).add(I::point(c[1]));
+        let next = C::new(z.re * z.re - z.im * z.im + c[0], 2. * z.re * z.im + c[1]);
+        if !super::finite(next) {
+            return None;
+        }
+        let rounding = norm_upper(
+            I::point(exact_re.sub(I::point(next.re)).abs_upper()),
+            I::point(exact_im.sub(I::point(next.im)).abs_upper()),
+        );
+        let r = I::point(radius);
+        let radius = I::point(2.)
+            .mul(I::point(norm_upper(re, im)))
+            .mul(r)
+            .add(r.square())
+            .add(I::point(rounding))
+            .hi;
+        if !radius.is_finite() || radius < 0. {
+            return None;
+        }
+        Some(Self {
+            center: next,
+            radius,
+        })
+    }
+}
+
+pub(super) fn escape(c: [f64; 2], budget: usize) -> Option<EscapeProof> {
+    if !c.into_iter().all(f64::is_finite) || budget == 0 || budget > 32768 {
+        return None;
+    }
+    let mut disk = Disk {
+        center: C::new(0., 0.),
+        radius: 0.,
+    };
+    for update in 0..budget {
+        if disk.proves_escape() {
+            return Some(EscapeProof {
+                update,
+                precision: 53,
+                radius_exponent: enclosing_exponent(disk.radius),
+            });
+        }
+        disk = disk.advance(c)?;
+    }
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::super::complex_ball::Complex as MP;
+    use super::*;
+    use astro_float::{BigFloat as B, RoundingMode as R};
+
+    fn mp(point: C) -> MP {
+        MP {
+            re: B::from_f64(point.re, 512),
+            im: B::from_f64(point.im, 512),
+        }
+    }
+    fn contains(disk: Disk, center: &MP, uncertainty: &B) -> bool {
+        let separation = center.distance_upper(&mp(disk.center), 512).unwrap();
+        separation
+            .add(uncertainty, 512, R::Up)
+            .cmp(&B::from_f64(disk.radius, 512))
+            .is_some_and(|order| order <= 0)
+    }
+
+    #[test]
+    fn exact_image_replay_catches_roundoff_linear_and_quadratic_radius_loss() {
+        for (disk, c, point) in [
+            (
+                Disk {
+                    center: C::new(0., 0.),
+                    radius: 0.25,
+                },
+                C::new(0., 0.),
+                C::new(0.25, 0.),
+            ),
+            (
+                Disk {
+                    center: C::new(1., 0.),
+                    radius: 0.125,
+                },
+                C::new(0., 0.),
+                C::new(1.125, 0.),
+            ),
+            (
+                Disk {
+                    center: C::new(1.1, 0.2),
+                    radius: 0.,
+                },
+                C::new(0.3, 0.4),
+                C::new(1.1, 0.2),
+            ),
+            (
+                Disk {
+                    center: C::new(-0.5, 0.5),
+                    radius: 2f64.powi(-26),
+                },
+                C::new(-0.75, 0.1),
+                C::new(-0.5 + 2f64.powi(-26), 0.5),
+            ),
+        ] {
+            assert!(contains(disk, &mp(point), &B::from(0u8)));
+            let next = disk.advance([c.re, c.im]).unwrap();
+            let (image, error) = mp(point).step(&mp(c), 512).unwrap();
+            assert!(
+                contains(next, &image, &error),
+                "exact image outside propagated disk"
+            );
+        }
+    }
+
+    #[test]
+    fn critical_prefixes_enclose_independent_512_bit_orbits() {
+        for c in [
+            C::new(0.32049988639807619, 0.04733531447355364),
+            C::new(0.35659381055433242, 0.06404656757776669),
+            C::new(f64::from_bits(1), -f64::from_bits(1)),
+            C::new(1., 0.),
+        ] {
+            let mut disk = Disk {
+                center: C::new(0., 0.),
+                radius: 0.,
+            };
+            let mut reference = mp(C::new(0., 0.));
+            let mut uncertainty = B::from(0u8);
+            let mut checked = 0;
+            for prefix in 0..2048 {
+                assert!(
+                    contains(disk, &reference, &uncertainty),
+                    "prefix {prefix}, c={c:?}"
+                );
+                checked += 1;
+                if disk.proves_escape() {
+                    break;
+                }
+                let Some(next) = disk.advance([c.re, c.im]) else {
+                    break;
+                };
+                (reference, uncertainty) = reference.advance(&uncertainty, &mp(c), 512).unwrap();
+                disk = next;
+            }
+            assert!(checked >= 4);
+            eprintln!("[FAST_PREFIX145] c={c:?} checked={checked}");
+        }
+    }
+    #[test]
+    fn radius_metadata_encloses_adjacent_powers_and_subnormals() {
+        for exponent in [-1022, -100, 0, 100, 1023] {
+            let power = f64::from_bits(((exponent + 1023) as u64) << 52);
+            assert_eq!(enclosing_exponent(power), Some(exponent));
+            assert_eq!(enclosing_exponent(power.next_up()), Some(exponent + 1));
+            assert_eq!(enclosing_exponent(power.next_down()), Some(exponent));
+        }
+        assert_eq!(enclosing_exponent(f64::from_bits(1)), Some(-1074));
+        assert_eq!(enclosing_exponent(f64::from_bits(2)), Some(-1073));
+        assert_eq!(enclosing_exponent(f64::from_bits(3)), Some(-1072));
+        assert_eq!(enclosing_exponent(f64::MAX), Some(1024));
+        for invalid in [0., -1., f64::NAN, f64::INFINITY] {
+            assert!(enclosing_exponent(invalid).is_none());
+        }
+    }
+    #[test]
+    fn strict_budget_and_independent_exterior_replay() {
+        assert!(escape([1., 0.], 3).is_none());
+        assert_eq!(escape([1., 0.], 4).unwrap().update, 3);
+        for point in [[1., 0.], [2., 0.], [-2.1, 0.], [0., 1.1]] {
+            let fast = escape(point, 32768).unwrap();
+            let replay = super::super::point_proof::escape(point, 512, fast.update + 1).unwrap();
+            assert!(replay.update <= fast.update);
+        }
+        for point in [[0., 0.], [-1., 0.], [0.25, 0.], [f64::NAN, 0.]] {
+            assert!(escape(point, 32768).is_none());
+        }
+        assert!(escape([2., 0.], 0).is_none());
+        assert!(escape([2., 0.], 32769).is_none());
+    }
+}
