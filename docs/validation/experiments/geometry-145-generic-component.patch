+#[derive(Debug)]
+pub(super) struct Proposal {
+    pub(super) distance: f64,
+    pub(super) period: usize,
+    pub(super) stationarity: f64,
+}
+fn project(query: C, mut z: C, mut c: C, period: usize, mut theta: f64) -> Option<Proposal> {
+    let mut best: Option<Proposal> = None;
+    for _ in 0..12 {
+        let mu = C::from_polar(1., theta);
+        (z, c) = solve(z, c, period, mu)?;
+        let (d1, d2) = derivatives(z, c, period, mu)?;
+        let r = c - query;
+        let speed = d1.norm();
+        let denominator = d1.norm_sqr() + dot(r, d2);
+        if !speed.is_finite() || speed <= 0. || !denominator.is_finite() || denominator <= 0. {
+            return None;
+        }
+        let stationarity = dot(r, d1).abs() / speed;
+        if !stationarity.is_finite() {
+            return None;
+        }
+        let distance = r.norm();
+        let alignment = (r.re * d1.im - r.im * d1.re) / (distance * speed);
+        if !distance.is_finite() || distance <= 0. || !alignment.is_finite() || alignment <= 0. {
+            return None;
+        }
+        if best
+            .as_ref()
+            .is_none_or(|old| stationarity < old.stationarity)
+        {
+            best = Some(Proposal {
+                distance,
+                period,
+                stationarity,
+            });
+        }
+        let delta = dot(r, d1) / denominator;
+        if !delta.is_finite() || delta.abs() > 0.1 {
+            return None;
+        }
+        if delta.abs() < 1e-13 {
+            break;
+        }
+        theta -= delta;
+    }
+    best
+}
+
+fn root_disk(z: C, c: C, period: usize) -> Option<C> {
+    if cycle(z, c, period)?.m.norm() >= 1. {
+        return None;
+    }
+    [1e-14, 1e-13, 1e-12, 1e-11, 1e-10, 1e-9, 1e-8]
+        .into_iter()
+        .find_map(|radius| {
+            super::uniform_box::proposal_cycle_trap([z.re, z.im], [c.re, c.im], period, radius)
+                .then_some(z)
+        })
+}
+fn attracting_root(mut z: C, c: C, period: usize) -> Option<C> {
+    for _ in 0..40 {
+        let j = cycle(z, c, period)?;
+        let residual = j.z - z;
+        if residual.norm() <= 64. * f64::EPSILON * z.norm().max(1.) {
+            return root_disk(z, c, period);
+        }
+        let step = residual / (j.m - 1.);
+        if !finite(step) {
+            return None;
+        }
+        let mut next = None;
+        for k in 0..24 {
+            let candidate = z - step * 2f64.powi(-k);
+            if let Some(n) = cycle(candidate, c, period) {
+                if (n.z - candidate).norm_sqr() < residual.norm_sqr() {
+                    next = Some(candidate);
+                    break;
+                }
+            }
+        }
+        let Some(next) = next else {
+            return root_disk(z, c, period);
+        };
+        z = next;
+    }
+    root_disk(z, c, period)
+}
+
+pub(super) fn propose(query: C) -> Option<Proposal> {
+    let mut orbit = crate::visual_metrics::MembershipOrbit::new(query);
+    let (seed, hint) = orbit.geometry_seed(32768)?;
+    let machine_period = if let Some(period) = hint {
+        period
+    } else {
+        let mut z = seed;
+        let mut best = (f64::INFINITY, 0);
+        for p in 1..=512 {
+            z = z * z + query;
+            let error = (z - seed).norm_sqr();
+            if error < best.0 {
+                best = (error, p);
+            }
+        }
+        best.1
+    };
+    if machine_period == 0 || machine_period > 32768 {
+        return None;
+    }
+    // Improve conditioning by choosing the phase nearest the critical point.
+    let mut z = seed;
+    let mut phase = seed;
+    for _ in 0..machine_period {
+        if z.norm_sqr() < phase.norm_sqr() {
+            phase = z;
+        }
+        z = z * z + query;
+    }
+    // A repeated machine cycle may be a multiple of the mathematical period.
+    // Divisor roots and numerical attraction only propose a reduced period;
+    // none of these floating checks issues a component certificate.
+    let (period, phase) = (1..=machine_period)
+        .filter(|p| *p <= 512 && machine_period % p == 0)
+        .find_map(|p| attracting_root(phase, query, p).map(|z| (p, z)))?;
+    let mu = cycle(phase, query, period)?.m;
+    let angle = mu.arg();
+    let mut best: Option<Proposal> = None;
+    for offset in [
+        0.,
+        -0.1,
+        0.1,
+        -0.2,
+        0.2,
+        -0.4,
+        0.4,
+        -0.8,
+        0.8,
+        -1.6,
+        1.6,
+        std::f64::consts::PI,
+    ] {
+        let theta = angle + offset;
+        let target = C::from_polar(1., theta);
+        let mut z = phase;
+        let mut c = query;
+        let mut valid = true;
+        for step in 1..=64 {
+            let t = f64::from(step) / 64.;
+            if let Some(pair) = solve(z, c, period, mu * (1. - t) + target * t) {
+                (z, c) = pair;
+            } else {
+                valid = false;
+                break;
+            }
+        }
+        if !valid {
+            continue;
+        }
+        if let Some(proposal) = project(query, z, c, period, theta) {
+            // This only ranks proposals. It does not certify global nearestness.
+            if best
+                .as_ref()
+                .is_none_or(|old| proposal.distance < old.distance)
+            {
+                best = Some(proposal);
+            }
+        }
+    }
+    best
+}
