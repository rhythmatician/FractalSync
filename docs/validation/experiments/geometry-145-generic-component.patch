+//! Numerical proposals only. This module cannot issue a Regular geometry jet.
+use num_complex::Complex64 as C;
+#[path = "periodic_boundary_cases.rs"]
+#[cfg(test)]
+mod cases;
+
+fn finite(z: C) -> bool {
+    z.re.is_finite() && z.im.is_finite()
+}
+fn dot(a: C, b: C) -> f64 {
+    a.re * b.re + a.im * b.im
+}
+struct Cycle {
+    z: C,
+    m: C,
+    a: C,
+    b: C,
+    d: C,
+}
+fn cycle(z: C, c: C, period: usize) -> Option<Cycle> {
+    let mut j = Cycle {
+        z,
+        m: C::new(1., 0.),
+        a: C::new(0., 0.),
+        b: C::new(0., 0.),
+        d: C::new(0., 0.),
+    };
+    for _ in 0..period {
+        j = Cycle {
+            z: j.z * j.z + c,
+            m: 2. * j.z * j.m,
+            a: 2. * j.z * j.a + 1.,
+            b: 2. * (j.m * j.m + j.z * j.b),
+            d: 2. * (j.a * j.m + j.z * j.d),
+        };
+        if ![j.z, j.m, j.a, j.b, j.d].into_iter().all(finite) {
+            return None;
+        }
+    }
+    Some(j)
+}
+
+// Return the best numerical iterate, including stagnation at machine precision.
+// A small step is deliberately not called a proof of root convergence.
+fn solve(mut z: C, mut c: C, period: usize, mu: C) -> Option<(C, C)> {
+    for _ in 0..40 {
+        let j = cycle(z, c, period)?;
+        let f = j.z - z;
+        let g = j.m - mu;
+        let det = (j.m - 1.) * j.d - j.a * j.b;
+        if !finite(det) || det.norm_sqr() == 0. {
+            return None;
+        }
+        let dz = (j.d * f - j.a * g) / det;
+        let dc = ((j.m - 1.) * g - j.b * f) / det;
+        if !finite(dz) || !finite(dc) {
+            return None;
+        }
+        let old = f.norm_sqr() + g.norm_sqr();
+        if dz.norm() <= 8. * f64::EPSILON * z.norm().max(1.)
+            && dc.norm() <= 8. * f64::EPSILON * c.norm().max(1.)
+        {
+            return Some((z, c));
+        }
+        let mut next = None;
+        for k in 0..24 {
+            let alpha = 2f64.powi(-k);
+            let nz = z - dz * alpha;
+            let nc = c - dc * alpha;
+            if let Some(n) = cycle(nz, nc, period) {
+                if (n.z - nz).norm_sqr() + (n.m - mu).norm_sqr() < old {
+                    next = Some((nz, nc));
+                    break;
+                }
+            }
+        }
+        let Some(pair) = next else {
+            return Some((z, c));
+        };
+        (z, c) = pair;
+    }
+    Some((z, c))
+}
+
+fn derivatives(z: C, c: C, period: usize, mu: C) -> Option<(C, C)> {
+    let j = cycle(z, c, period)?;
+    let det = (j.m - 1.) * j.d - j.a * j.b;
+    let mu1 = C::new(-mu.im, mu.re);
+    let z1 = -j.a * mu1 / det;
+    let c1 = (j.m - 1.) * mu1 / det;
+    let (mut v, mut v1, mut v2) = (z, z1, C::new(0., 0.));
+    let (mut m, mut m1, mut m2) = (C::new(1., 0.), C::new(0., 0.), C::new(0., 0.));
+    for _ in 0..period {
+        let nv2 = 2. * (v1 * v1 + v * v2);
+        let nm2 = 2. * (v2 * m + 2. * v1 * m1 + v * m2);
+        let nv1 = 2. * v * v1 + c1;
+        let nm1 = 2. * (v1 * m + v * m1);
+        let nv = v * v + c;
+        let nm = 2. * v * m;
+        (v, v1, v2, m, m1, m2) = (nv, nv1, nv2, nm, nm1, nm2);
+    }
+    let rhs_f = -v2;
+    let rhs_g = -mu - m2;
+    let c2 = ((j.m - 1.) * rhs_g - j.b * rhs_f) / det;
+    (finite(c1) && finite(c2)).then_some((c1, c2))
+}
