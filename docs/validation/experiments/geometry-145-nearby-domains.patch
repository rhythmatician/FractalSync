+/// A neighboring patch only proposes the first domain size. A fresh strict
+/// certificate remains mandatory, and a failed proposal uses the original
+/// bounded search without changing any of its acceptance checks.
+pub(super) fn certify_nearby(
+    z: &C,
+    c: &C,
+    mu: &C,
+    period: usize,
+    mu_radius: f64,
+    previous: Option<&Certificate>,
+) -> Result<(Certificate, usize), Refusal> {
+    let mut extra_attempts = 0;
+    if let Some(previous) = previous.filter(|patch| {
+        patch.period() == period && patch.mu_radius.is_finite() && patch.mu_radius > 0.
+    }) {
+        let ratio = mu_radius / previous.mu_radius;
+        let scale = 2. * ratio * ratio;
+        // Reuse the measured enclosure, not the requested domain. Repeatedly
+        // inflating the latter compounds slack along an otherwise smooth arc.
+        let errors = [
+            (previous.inclusion[0] * scale).max(1e-22),
+            (previous.inclusion[1] * scale).max(1e-26),
+        ];
+        if mu_radius.is_finite()
+            && mu_radius > 0.
+            && errors.iter().all(|value| value.is_finite() && *value > 0.)
+        {
+            extra_attempts = 1;
+            if let Ok(patch) = certify(z, c, mu, period, mu_radius, errors[0], errors[1]) {
+                return Ok((patch, 1));
+            }
+        }
+    }
+    certify_auto(z, c, mu, period, mu_radius)
+        .map(|(patch, attempts)| (patch, attempts + extra_attempts))
+}
+
 fn subtract(a: &C, b: &C) -> Option<(C, B)> {
     add(a, &b.scale(-1.))
 }
