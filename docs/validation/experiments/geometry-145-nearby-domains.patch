     #[test]
+    fn neighboring_domain_is_only_a_hint_and_keeps_strict_proof_gates() {
+        let mu = C::new(-0.4, 0.6);
+        let z = mu.scale(0.5);
+        let c = mu.scale(0.5).sub(&mu.mul(&mu).scale(0.25));
+        let (previous, cold_attempts) = certify_auto(&z, &c, &mu, 1, 1e-3).unwrap();
+        let (warm, warm_attempts) = certify_nearby(&z, &c, &mu, 1, 1e-3, Some(&previous)).unwrap();
+        assert!(warm_attempts < cold_attempts);
+        assert!(warm.contraction < 1.);
+        assert!(warm.inclusion[0] < warm.z_error && warm.inclusion[1] < warm.c_error);
+        // A valid neighboring proof cannot replace validation of new inputs.
+        assert!(certify_nearby(&C::new(f64::NAN, 0.), &c, &mu, 1, 1e-3, Some(&previous)).is_err());
+        assert!(matches!(
+            certify_nearby(&z, &c, &mu, 1, f64::NAN, Some(&previous)),
+            Err(Refusal::InvalidRequest)
+        ));
+        // A bad size proposal must not suppress the original successful search.
+        let mut oversized = previous.clone();
+        oversized.inclusion = [1e100; 2];
+        let (fallback, attempts) = certify_nearby(&z, &c, &mu, 1, 1e-3, Some(&oversized)).unwrap();
+        assert_eq!(attempts, cold_attempts + 1);
+        assert_eq!(fallback.inclusion, previous.inclusion);
+        // Nonfinite proposals and a different period skip the hint entirely.
+        oversized.mu_radius = f64::NAN;
+        assert_eq!(
+            certify_nearby(&z, &c, &mu, 1, 1e-3, Some(&oversized))
+                .unwrap()
+                .1,
+            cold_attempts
+        );
+        oversized = previous.clone();
+        oversized.model.period = 2;
+        assert_eq!(
+            certify_nearby(&z, &c, &mu, 1, 1e-3, Some(&oversized))
+                .unwrap()
+                .1,
+            cold_attempts
+        );
+    }
