+fn component_features(c:Complex64,h:f64)->Option<Vec<NearestFeature>> {
+ component_distance(c)?;
+ let r=(c.re+1.).hypot(c.im);
+ let points=if r<0.25 {
+  if r==0. {vec![[-0.75,0.],[-1.25,0.]]} else {
+   let v=[0.25*(c.re+1.)/r,0.25*c.im/r];vec![[-1.+v[0],v[1]],[-1.-v[0],-v[1]]]
+  }
+ } else {
+  let x=c.re;let y=c.im;let a=[0.5-2.*x,-6.*y,6.*x+0.5,2.*y];let mut theta=vec![0.];
+  theta.extend(roots(a).into_iter().map(|s|2.*s.atan()));
+  theta.extend(roots([a[3],a[2],a[1],a[0]]).into_iter().map(|r|std::f64::consts::PI-2.*r.atan()));
+  theta.into_iter().map(|t|[0.5*t.cos()-0.25*(2.*t).cos(),0.5*t.sin()-0.25*(2.*t).sin()]).collect()
+ };
+ let best=points.iter().map(|p|(c.re-p[0]).hypot(c.im-p[1])).fold(f64::INFINITY,f64::min);
+ let features:Vec<_>=points.into_iter().filter_map(|p| {
+  let d=(c.re-p[0]).hypot(c.im-p[1]);
+  (d>0. && d-best<=DYADIC_CUT_TIE_FACTOR*h).then_some(NearestFeature{projection:(p[0],p[1]),direction:((c.re-p[0])/d,(c.im-p[1])/d)})
+ }).collect();
+ Some(features)
+}
+fn component_level(c:Complex64,epsilon:f64,k:u32,h:f64)->Option<FittedJet> {
+ let d0=component_distance(c)?;
+ let stencil:Option<Vec<_>>=distance_stencil(c,h).map(|p|component_distance(p).map(|d|(p.re-c.re,p.im-c.im,d))).collect();
+ let stencil=stencil?;
+ let center:Vec<_>=(1..8).flat_map(|y|(1..8).map(move|x|(y,x))).map(|(y,x)|stencil[y*9+x]).collect();
+ let (_,rms)=fit_quadratic_jet(&center)?;
+ let (field,detail)=quintic_field(c,h,&stencil);
+ let rms=rms.max((field.d-d0).abs());
+ let mut jet=failure_jet(field.d,h,GeometryValidity::Regular,SingularityKind::None);
+ jet.grad_d=field.g;jet.hessian_d=field.h;jet.estimated_error=rms;
+ jet.requested_scale=GEOMETRY_SCALE_ALPHA*(field.d*field.d+epsilon*epsilon).sqrt();
+ jet.tile_id=format!("component:{k}");jet.is_bridge=false;
+ Some(FittedJet{nodes_certified:true,detail,jet,fit_rms:rms,stencil})
 }

