+#[cfg(test)] mod bounded_selector_tests {
+ use super::*;
+ fn make(d:f64,h:f64)->GeometryJet {
+  let mut jet=failure_jet(d,h,GeometryValidity::Regular,SingularityKind::None);
+  jet.grad_d=[0.;2];jet.hessian_d=[[0.;2];2];jet.estimated_error=0.;jet
+ }
+ #[test] fn interval_field_bound_encloses_node_endpoint_extrema() {
+  let c=Complex64::new(0.32046083605181780,0.04736134021833255);let h=dyadic_h(13);
+  let bound=scalar_field_bound(c,h);
+  let points:Vec<_>=distance_stencil(c,h).collect();
+  let upper:Vec<_>=points.iter().map(|p|distance_upper([p.re,p.im])).collect();
+  let mut nodes:Vec<_>=points.iter().map(|p|(p.re-c.re,p.im-c.im,0.)).collect();
+  let mut weights=Vec::new();
+  for i in 0..81 {nodes[i].2=1.;weights.push(quintic_field(c,h,&nodes).0.d);nodes[i].2=0.;}
+  for i in 0..81 {nodes[i].2=upper[i].copysign(weights[i]);}
+  assert!(quintic_field(c,h,&nodes).0.d.abs()<=bound);
+  for i in 0..81 {nodes[i].2= -nodes[i].2;}
+  assert!(quintic_field(c,h,&nodes).0.d.abs()<=bound);
+  assert!(size_saturated_by_bound(h,1e-4,bound));
+ }
+ #[test] fn interval_certificate_forces_the_actual_gate_for_the_full_scalar_range() {
+  let c=Complex64::new(0.32046083605181780,0.04736134021833255);let h=dyadic_h(13);
+  let bound=scalar_field_bound(c,h);
+  for i in -100..=100 {
+   let field=FieldJet {d:bound*f64::from(i)/100.,g:[100.,-200.],h:[[300.,400.],[400.,-500.]]};
+   let weight=FieldHierarchy::next_weight(field,h,1e-4,FieldJet::constant(0.));
+   assert_eq!(weight.d,1.);assert_eq!(weight.g,[0.;2]);assert_eq!(weight.h,[[0.;2];2]);
+  }
+ }
+ #[test] fn independently_bounded_one_can_discard_an_uncertified_coarse_model() {
+  let c=Complex64::new(0.32046083605181780,0.04736134021833255);let h=dyadic_h(13);
+  let zero=FieldJet::constant(0.);let bound=scalar_field_bound(c,h);
+  let mut bounded=FieldHierarchy::new_bounded(&make(4e-5,h),1e-4,false,zero,bound);
+  let mut unknown=FieldHierarchy::new(&make(4e-5,h),1e-4,false,zero);
+  for k in 14..=28 {
+   let jet=make(4e-5,dyadic_h(k));
+   bounded.advance(&jet,1e-4,true,zero);unknown.advance(&jet,1e-4,true,zero);
+  }
+  assert!(bounded.closed && bounded.certified);
+  assert!(unknown.closed && !unknown.certified);
+  assert_eq!(bounded.sum.d,4e-5);
+ }
+ #[test] fn a_small_or_zero_weight_cannot_use_the_one_certificate() {
+  let h=dyadic_h(26);let zero=FieldJet::constant(0.);
+  assert!(!size_saturated_by_bound(h,1e-4,0.));
+  let mut field=FieldHierarchy::new_bounded(&make(0.,h),1e-4,false,zero,0.);
+  for k in 27..=30 {field.advance(&make(0.,dyadic_h(k)),1e-4,true,zero);}
+  assert!(field.closed && !field.certified);
+ }
+ #[test] fn an_unbounded_finer_dependency_still_prevents_certification() {
+  let c=Complex64::new(0.32046083605181780,0.04736134021833255);let h=dyadic_h(13);
+  let zero=FieldJet::constant(0.);
+  let mut field=FieldHierarchy::new_bounded(&make(4e-5,h),1e-4,false,zero,scalar_field_bound(c,h));
+  field.advance(&make(4e-5,dyadic_h(14)),1e-4,false,zero);
+  for k in 15..=28 {field.advance(&make(4e-5,dyadic_h(k)),1e-4,true,zero);}
+  assert!(field.closed && !field.certified);
+ }
