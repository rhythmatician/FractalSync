+fn boundary_parameters(c:[f64;2])->Vec<(f64,bool)> {
+ let [x,y]=c;let a=[0.5-2.*x,-6.*y,6.*x+0.5,2.*y];
+ let mut values=vec![(0.,false),(0.,true)];
+ values.extend(roots(a).into_iter().map(|s|(s,false)));
+ values.extend(roots([a[3],a[2],a[1],a[0]]).into_iter().map(|s|(s,true)));
+ values
+}
+#[derive(Clone,Copy)]
+struct BoundaryInterval {lo:f64,hi:f64}
+impl BoundaryInterval {
+    fn point(x:f64)->Self {Self{lo:x,hi:x}}
+    fn add(self,b:Self)->Self {Self{lo:(self.lo+b.lo).next_down(),hi:(self.hi+b.hi).next_up()}}
+    fn neg(self)->Self {Self{lo:-self.hi,hi:-self.lo}}
+    fn sub(self,b:Self)->Self {self.add(b.neg())}
+    fn mul(self,b:Self)->Self {
+        let p=[self.lo*b.lo,self.lo*b.hi,self.hi*b.lo,self.hi*b.hi];
+        Self{lo:p.into_iter().fold(f64::INFINITY,f64::min).next_down(),hi:p.into_iter().fold(f64::NEG_INFINITY,f64::max).next_up()}
+    }
+    fn div_positive(self,b:Self)->Self {
+        assert!(b.lo>0.);
+        self.mul(Self{lo:(1./b.hi).next_down(),hi:(1./b.lo).next_up()})
+    }
+    fn abs_upper(self)->f64 {self.lo.abs().max(self.hi.abs())}
+}
+fn boundary_box(parameter:f64,cotangent:bool)->[BoundaryInterval;2] {
+    let one=BoundaryInterval::point(1.);
+    let s=BoundaryInterval::point(parameter);
+    let q=s.mul(s);
+    let denominator=one.add(q);
+    let numerator=if cotangent {q.sub(one)} else {one.sub(q)};
+    let u=numerator.div_positive(denominator);
+    let v=BoundaryInterval::point(2.).mul(s).div_positive(denominator);
+    let half=BoundaryInterval::point(0.5);
+    let quarter=BoundaryInterval::point(0.25);
+    [half.mul(u).sub(quarter.mul(u.mul(u).sub(v.mul(v)))),half.mul(v).sub(half.mul(u.mul(v)))]
+}
+fn distance_upper(c:[f64;2])->f64 {
+    boundary_parameters(c).into_iter().map(|(s,cot)| {
+        let p=boundary_box(s,cot);
+        let x=BoundaryInterval::point(c[0]).sub(p[0]).abs_upper();
+        let y=BoundaryInterval::point(c[1]).sub(p[1]).abs_upper();
+        ((x*x).next_up()+(y*y).next_up()).next_up().sqrt().next_up()
+    }).fold(f64::INFINITY,f64::min)
+}
+
+fn bounded_component_distance(c:Complex64)->Option<f64> {
+ component_distance(c).map(|d| {let upper=distance_upper([c.re,c.im]);d.clamp(-upper,upper)})
+}
+fn scalar_field_bound(c:Complex64,h:f64)->f64 {
+ let tx=c.re/h-(c.re/h).floor();let ty=c.im/h-(c.im/h).floor();
+ let basis=|t:f64|->Vec<BoundaryInterval> {
+  QUINTIC_BASIS.iter().map(|polynomial| {
+   let mut value=BoundaryInterval::point(0.);
+   for &coefficient in polynomial.iter().rev() {
+    value=value.mul(BoundaryInterval::point(t)).add(BoundaryInterval::point(coefficient));
+   }
+   value.div_positive(BoundaryInterval::point(120.))
+  }).collect()
+ };
+ let wx=basis(tx);let wy=basis(ty);
+ let nodes:Vec<_>=distance_stencil(c,h).map(|p| {let upper=distance_upper([p.re,p.im]);BoundaryInterval{lo:-upper,hi:upper}}).collect();
+ let reference=nodes[40];
+ let half=BoundaryInterval::point(0.5);let quarter=BoundaryInterval::point(0.25);
+ let sx=nodes[41].sub(nodes[39]).mul(half);let sy=nodes[49].sub(nodes[31]).mul(half);
+ let mut sum=BoundaryInterval::point(0.);
+ for y in 0..6 {for x in 0..6 {
+  let index=(y+2)*9+x+2;let center=nodes[index];
+  let laplacian=nodes[index-1].sub(center).add(nodes[index+1].sub(center)).add(nodes[index-9].sub(center)).add(nodes[index+9].sub(center));
+  let coefficient=center.sub(quarter.mul(laplacian)).sub(reference).sub(sx.mul(BoundaryInterval::point(x as f64-2.))).sub(sy.mul(BoundaryInterval::point(y as f64-2.)));
+  sum=sum.add(wx[x].mul(wy[y]).mul(coefficient));
+ }}
+ sum.add(reference.add(sx.mul(BoundaryInterval::point(tx))).add(sy.mul(BoundaryInterval::point(ty)))).abs_upper()
+}
+fn size_saturated_by_bound(h:f64,epsilon:f64,bound:f64)->bool {
+ if !bound.is_finite() {return false;}
+ let b=BoundaryInterval::point(bound);let e=BoundaryInterval::point(epsilon);
+ let rho_upper=b.mul(b).add(e.mul(e)).hi.sqrt().next_up();
+ let inverse_lower=(1./rho_upper).next_down();
+ let scale_lower=(h/(GEOMETRY_SCALE_ALPHA/128.)).next_down();
+ (inverse_lower*scale_lower).next_down()>2.
 }
 
