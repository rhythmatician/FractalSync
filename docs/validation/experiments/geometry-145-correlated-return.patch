+use num_complex::Complex64;
+use runtime_core::geometry_provider::{query_geometry, GeometryValidity, DYADIC_FIT_ERROR_FACTOR};
+
+fn main() {
+    let args: Vec<_> = std::env::args().skip(1).map(|value| value.parse::<f64>().unwrap()).collect();
+    assert_eq!(args.len(), 3, "expected X Y EPSILON");
+    let start = std::time::Instant::now();
+    let jet = query_geometry(Complex64::new(args[0], args[1]), args[2]).unwrap();
+    if jet.validity == GeometryValidity::Regular {
+        assert!(jet.resolved_scale <= jet.requested_scale);
+        assert!(jet.estimated_error <= DYADIC_FIT_ERROR_FACTOR * jet.requested_scale);
+    }
+    println!("{}", serde_json::json!({"c":[args[0],args[1]],"epsilon":args[2],
+        "elapsed_s":start.elapsed().as_secs_f64(),"jet":jet}));
+}
