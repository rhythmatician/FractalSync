+fn periodic_affine_trap(prefix:affine_return::AffineBall, centers:&[[f64;2]],c:[f64;2],cr:f64)->bool {
+ let Some(last)=centers.len().checked_sub(1) else {return false;};
+ let mut period=0;let mut separation=f64::INFINITY;
+ for p in 1..=last {
+  let distance=distance_upper(prefix.z,centers[last-p]);
+  if distance<separation {period=p;separation=distance;}
+ }
+ for factor in [2.,8.,32.,128.] {
+  let radius=upper_mul(factor,upper_add(prefix.remainder,separation));
+  if prefix.traps(c,cr,period,radius) {return true;}
+ }
