+#[derive(Clone, Copy)]
+struct SearchRegion {
+    lower: f64,
+    bounds: [i64; 4],
+}
+impl PartialEq for SearchRegion {
+    fn eq(&self, other: &Self) -> bool {
+        self.lower == other.lower && self.bounds == other.bounds
+    }
+}
+impl Eq for SearchRegion {}
+impl PartialOrd for SearchRegion {
+    fn partial_cmp(&self, other: &Self) -> Option<std::cmp::Ordering> {
+        Some(self.cmp(other))
+    }
+}
+impl Ord for SearchRegion {
+    fn cmp(&self, other: &Self) -> std::cmp::Ordering {
+        other
+            .lower
+            .total_cmp(&self.lower)
+            .then_with(|| other.bounds.cmp(&self.bounds))
+    }
+}
+const FIELD_REGION_VISIT_LIMIT: usize = 131072;
+const FIELD_LEAF_TILE_LIMIT: usize = 16384;
+const FIELD_SEARCH_RADIUS: i64 = 4096;
+struct RegionSearch {
+    visits: usize,
+    leaves: usize,
+    nearest: f64,
+}
+impl RegionSearch {
+    fn visit(
+        &mut self,
+        c: Complex64,
+        k: u32,
+        base: (i64, i64),
+        bounds: [i64; 4],
+        output: &mut ShoreTile,
+    ) -> Result<(), TileQueryError> {
+        let h = output.h;
+        let stride = (DYADIC_TILE_CELLS / DYADIC_CORE_CELLS) as i64;
+        let origin = |g: i64, b: i64| {
+            ((b + g * stride) * DYADIC_CORE_CELLS as i64 - DYADIC_HALO_CELLS as i64) as f64 * h
+        };
+        let lower = |r: [i64; 4]| {
+            let re = origin(r[0], base.0);
+            let im = origin(r[2], base.1);
+            let w = (r[1] - r[0] + 1) as f64 * DYADIC_TILE_CELLS as f64 * h;
+            let ht = (r[3] - r[2] + 1) as f64 * DYADIC_TILE_CELLS as f64 * h;
+            (re - c.re)
+                .max(c.re - re - w)
+                .max(0.)
+                .hypot((im - c.im).max(c.im - im - ht).max(0.))
+        };
+        let mut heap = std::collections::BinaryHeap::new();
+        heap.push(SearchRegion {
+            lower: lower(bounds),
+            bounds,
+        });
+        while let Some(region) = heap.pop() {
+            self.visits += 1;
+            if self.visits > FIELD_REGION_VISIT_LIMIT {
+                eprintln!(
+                    "REGION_LIMIT k={k} leaves={} visits={}",
+                    self.leaves, self.visits
+                );
+                return Err(TileQueryError::FootprintUnresolved);
+            }
+            if region.lower > self.nearest + (10. * 2_f64.sqrt() + 4.) * h {
+                break;
+            }
+            let [x0, x1, y0, y1] = region.bounds;
+            let re0 = origin(x0, base.0);
+            let im0 = origin(y0, base.1);
+            let width = (x1 - x0 + 1) as f64 * DYADIC_TILE_CELLS as f64 * h;
+            let height = (y1 - y0 + 1) as f64 * DYADIC_TILE_CELLS as f64 * h;
+            if uniform_box::membership(re0, im0, width.max(height)).is_some() {
+                continue;
+            }
+            if x0 == x1 && y0 == y1 {
+                self.leaves += 1;
+                if self.leaves > FIELD_LEAF_TILE_LIMIT {
+                    eprintln!(
+                        "LEAF_LIMIT k={k} leaves={} visits={}",
+                        self.leaves, self.visits
+                    );
+                    return Err(TileQueryError::FootprintUnresolved);
+                }
+                let tile =
+                    get_or_generate_shore_tile(k, base.0 + x0 * stride, base.1 + y0 * stride)
+                        .ok_or(TileQueryError::MembershipUnresolved)?;
+                self.nearest = tile.segments.iter().fold(self.nearest, |d, s| {
+                    d.min(point_to_segment_distance(c.re, c.im, s).0)
+                });
+                output.segments.extend(tile.segments);
+                output.unstable_nodes.extend(tile.unstable_nodes);
+                continue;
+            }
+            let (a, b) = if x1 - x0 >= y1 - y0 {
+                let mid = (x0 + x1).div_euclid(2);
+                ([x0, mid, y0, y1], [mid + 1, x1, y0, y1])
+            } else {
+                let mid = (y0 + y1).div_euclid(2);
+                ([x0, x1, y0, mid], [x0, x1, mid + 1, y1])
+            };
+            heap.push(SearchRegion {
+                lower: lower(a),
+                bounds: a,
+            });
+            heap.push(SearchRegion {
+                lower: lower(b),
+                bounds: b,
+            });
+        }
+        Ok(())
