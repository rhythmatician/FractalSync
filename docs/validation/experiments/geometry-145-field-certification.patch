+// Unshipped scalar-field experiment. All derivatives include blend weights.
+#[derive(Clone, Copy)]
+struct FieldJet {
+    d: f64,
+    g: [f64; 2],
+    h: [[f64; 2]; 2],
+}
+impl FieldJet {
+    fn constant(d: f64) -> Self {
+        Self {
+            d,
+            g: [0.0; 2],
+            h: [[0.0; 2]; 2],
+        }
+    }
+    fn from_geometry(jet: &GeometryJet) -> Self {
+        Self {
+            d: jet.d,
+            g: jet.grad_d,
+            h: jet.hessian_d,
+        }
+    }
+    fn add(self, other: Self) -> Self {
+        let mut result = self;
+        result.d += other.d;
+        for i in 0..2 {
+            result.g[i] += other.g[i];
+            for j in 0..2 {
+                result.h[i][j] += other.h[i][j];
+            }
+        }
+        result
+    }
+    fn scale(self, factor: f64) -> Self {
+        let mut result = self;
+        result.d *= factor;
+        for i in 0..2 {
+            result.g[i] *= factor;
+            for j in 0..2 {
+                result.h[i][j] *= factor;
+            }
+        }
+        result
+    }
+    fn mul(self, other: Self) -> Self {
+        let mut result = Self::constant(self.d * other.d);
+        for i in 0..2 {
+            result.g[i] = self.g[i] * other.d + self.d * other.g[i];
+            for j in 0..2 {
+                result.h[i][j] = self.h[i][j] * other.d
+                    + self.g[i] * other.g[j]
+                    + self.g[j] * other.g[i]
+                    + self.d * other.h[i][j];
+            }
+        }
+        result
+    }
+    fn compose(self, value: f64, first: f64, second: f64) -> Self {
+        let mut result = Self::constant(value);
+        for i in 0..2 {
+            result.g[i] = first * self.g[i];
+            for j in 0..2 {
+                result.h[i][j] = first * self.h[i][j] + second * self.g[i] * self.g[j];
+            }
+        }
+        result
+    }
+    fn reciprocal(self) -> Self {
+        self.compose(1.0 / self.d, -1.0 / self.d.powi(2), 2.0 / self.d.powi(3))
+    }
+    fn sqrt(self) -> Self {
+        let v = self.d.sqrt();
+        self.compose(v, 0.5 / v, -0.25 / (self.d * v))
+    }
+    fn smoothstep(self) -> Self {
+        if self.d <= 0.0 {
+            return Self::constant(0.0);
+        }
+        if self.d >= 1.0 {
+            return Self::constant(1.0);
+        }
+        let x = self.d;
+        self.compose(
+            x.powi(3) * (10.0 - 15.0 * x + 6.0 * x * x),
+            30.0 * x * x * (x - 1.0).powi(2),
+            60.0 * x * (2.0 * x * x - 3.0 * x + 1.0),
+        )
+    }
+}
+
+struct FieldModel {
+    field: FieldJet,
+    h: f64,
+    detail: FieldJet,
+    certified: bool,
+}
+struct FieldHierarchy {
+    models: Vec<FieldModel>,
+    sum: FieldJet,
+    product: FieldJet,
+    effective_h: f64,
+    closed: bool,
+    certified: bool,
+}
+fn field_zero(field: FieldJet) -> bool {
+    field.d == 0. && field.g == [0.; 2] && field.h == [[0.; 2]; 2]
+}
+impl FieldHierarchy {
+    fn next_weight(previous: FieldJet, h: f64, epsilon: f64, detail: FieldJet) -> FieldJet {
+        let rho = previous
+            .mul(previous)
+            .add(FieldJet::constant(epsilon * epsilon))
+            .sqrt();
+        let size = rho
+            .reciprocal()
+            .scale(h / (GEOMETRY_SCALE_ALPHA / 8.))
+            .add(FieldJet::constant(-1.))
+            .smoothstep();
+        Self::either(size, detail)
+    }
+    fn either(a: FieldJet, b: FieldJet) -> FieldJet {
+        FieldJet::constant(1.).add(
+            FieldJet::constant(1.)
+                .add(a.scale(-1.))
+                .mul(FieldJet::constant(1.).add(b.scale(-1.)))
+                .scale(-1.),
+        )
+    }
+    fn disagreement(coarse: FieldJet, fine: FieldJet, epsilon: f64) -> FieldJet {
+        let delta = fine.add(coarse.scale(-1.));
+        let rho2 = coarse
+            .mul(coarse)
+            .add(FieldJet::constant(epsilon * epsilon));
+        delta
+            .mul(delta)
+            .mul(rho2.reciprocal())
+            .scale(16. / (GEOMETRY_SCALE_ALPHA * DYADIC_FIT_ERROR_FACTOR).powi(2))
+            .add(FieldJet::constant(-1.))
+            .smoothstep()
+    }
+    fn new(jet: &GeometryJet, _epsilon: f64, certified: bool, detail: FieldJet) -> Self {
+        let field = FieldJet::from_geometry(jet);
+        Self {
+            models: vec![FieldModel {
+                field,
+                h: jet.resolved_scale,
+                detail,
+                certified,
+            }],
+            sum: field,
+            product: FieldJet::constant(1.),
+            effective_h: jet.resolved_scale,
+            closed: false,
+            certified,
+        }
+    }
+    fn advance(&mut self, jet: &GeometryJet, epsilon: f64, certified: bool, detail: FieldJet) {
+        self.models.push(FieldModel {
+            field: FieldJet::from_geometry(jet),
+            h: jet.resolved_scale,
+            detail,
+            certified,
+        });
+        let mut prefix = FieldJet::constant(0.);
+        let mut prefix_h: f64 = 0.;
+        let mut prefix_certified = true;
+        let mut weights_certified = true;
+        let mut product = FieldJet::constant(1.);
+        self.sum = self.models[0].field;
+        self.effective_h = self.models[0].h;
+        self.certified = self.models[0].certified;
+        self.closed = false;
+        for i in 0..self.models.len().saturating_sub(2) {
+            let coarse = &self.models[i];
+            let first = &self.models[i + 1];
+            let second = &self.models[i + 2];
+            let size = Self::next_weight(coarse.field, coarse.h, epsilon, coarse.detail);
+            let error1 = Self::disagreement(coarse.field, first.field, epsilon);
+            let error2 = Self::disagreement(coarse.field, second.field, epsilon);
+            let weight = Self::either(size, Self::either(error1, error2));
+            let next = if weight.d == 1. && weight.g == [0.; 2] && weight.h == [[0.; 2]; 2] {
+                product
+            } else if field_zero(weight) {
+                FieldJet::constant(0.)
+            } else {
+                product.mul(weight)
+            };
+            let one = |v: FieldJet| v.d == 1. && v.g == [0.; 2] && v.h == [[0.; 2]; 2];
+            // A flat coefficient alone cannot certify the inputs selecting it.
+            // A certified operand that independently forces OR to one can
+            // dominate other unknown operands; a zero plateau cannot.
+            weights_certified &= coarse.certified
+                && (one(size)
+                    || (first.certified && one(error1))
+                    || (second.certified && one(error2))
+                    || (first.certified && second.certified));
+            let retained = product.add(next.scale(-1.));
+            if !field_zero(retained) {
+                prefix = prefix.add(retained.mul(coarse.field));
+                prefix_h = prefix_h.max(coarse.h);
+                prefix_certified &= coarse.certified;
+            }
+            self.sum = prefix.add(next.mul(first.field));
+            self.product = next;
+            self.closed = field_zero(next);
+            self.effective_h = prefix_h.max(if self.closed { 0. } else { first.h });
+            self.certified =
+                prefix_certified && weights_certified && (self.closed || first.certified);
+            if self.closed {
+                break;
+            }
+            product = next;
+        }
+    }
+    fn output(&self, raw: &GeometryJet, epsilon: f64) -> GeometryJet {
+        let mut result = raw.clone();
+        let ge = (self.sum.g[0] - raw.grad_d[0]).hypot(self.sum.g[1] - raw.grad_d[1]);
+        let he = ((self.sum.h[0][0] - raw.hessian_d[0][0]).powi(2)
+            + 2. * (self.sum.h[0][1] - raw.hessian_d[0][1]).powi(2)
+            + (self.sum.h[1][1] - raw.hessian_d[1][1]).powi(2))
+        .sqrt();
+        let comparison_h = self.effective_h.max(2. * raw.resolved_scale);
+        result.estimated_error = result
+            .estimated_error
+            .max((self.sum.d - raw.d).abs())
+            .max(comparison_h * ge)
+            .max(comparison_h * comparison_h * he);
+        result.d = self.sum.d;
+        result.grad_d = self.sum.g;
+        result.hessian_d = self.sum.h;
+        result.resolved_scale = self.effective_h;
+        result.requested_scale =
+            GEOMETRY_SCALE_ALPHA * (self.sum.d * self.sum.d + epsilon * epsilon).sqrt();
+        result
+    }
+}
