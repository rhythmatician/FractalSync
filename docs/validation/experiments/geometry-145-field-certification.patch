+fn distance_stencil(c: Complex64, h: f64) -> impl Iterator<Item = Complex64> {
+    let x = (c.re / h).floor();
+    let y = (c.im / h).floor();
+    (-4..=4).flat_map(move |dy| {
+        (-4..=4).map(move |dx| Complex64::new((x + dx as f64) * h, (y + dy as f64) * h))
+    })
+}
