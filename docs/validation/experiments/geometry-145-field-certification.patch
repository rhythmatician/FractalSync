+// Exact integer coefficient polynomials, ordered from t^0 through t^5.
+fn quintic_basis(t: f64) -> [[f64; 6]; 5] {
+    const P: [[f64; 6]; 6] = [
+        [1., -5., 10., -10., 5., -1.],
+        [26., -50., 20., 20., -20., 5.],
+        [66., 0., -60., 0., 30., -10.],
+        [26., 50., 20., -20., -20., 10.],
+        [1., 5., 10., 10., 5., -5.],
+        [0., 0., 0., 0., 0., 1.],
+    ];
+    let mut result = [[0.; 6]; 5];
+    for derivative in 0..5 {
+        for basis in 0..6 {
+            let mut value = 0.;
+            for power in (derivative..6).rev() {
+                let factor = (0..derivative).fold(1., |product, i| product * (power - i) as f64);
+                value = value * t + P[basis][power] * factor;
+            }
+            result[derivative][basis] = value / 120.;
+        }
+    }
+    result
+}
+
+fn quintic_field(c: Complex64, h: f64, nodes: &[(f64, f64, f64)]) -> (FieldJet, FieldJet) {
+    let tx = c.re / h - (c.re / h).floor();
+    let ty = c.im / h - (c.im / h).floor();
+    let wx = quintic_basis(tx);
+    let wy = quintic_basis(ty);
+    let reference = nodes[40].2;
+    let sx = (nodes[41].2 - nodes[39].2) * 0.5;
+    let sy = (nodes[49].2 - nodes[31].2) * 0.5;
+    let mut derivatives = [[0.; 5]; 5];
+    for y in 0..6 {
+        for x in 0..6 {
+            let index = (y + 2) * 9 + x + 2;
+            let center = nodes[index].2;
+            let laplacian = (nodes[index - 1].2 - center)
+                + (nodes[index + 1].2 - center)
+                + (nodes[index - 9].2 - center)
+                + (nodes[index + 9].2 - center);
+            let coefficient =
+                center - 0.25 * laplacian - reference - sx * (x as f64 - 2.) - sy * (y as f64 - 2.);
+            for dx in 0..5 {
+                for dy in 0..5 - dx {
+                    derivatives[dx][dy] +=
+                        wx[dx][x] * wy[dy][y] * coefficient / h.powi((dx + dy) as i32);
+                }
+            }
+        }
+    }
+    derivatives[0][0] += reference + sx * tx + sy * ty;
+    derivatives[1][0] += sx / h;
+    derivatives[0][1] += sy / h;
+    let component = |dx: usize, dy: usize| FieldJet {
+        d: derivatives[dx][dy],
+        g: [derivatives[dx + 1][dy], derivatives[dx][dy + 1]],
+        h: [
+            [derivatives[dx + 2][dy], derivatives[dx + 1][dy + 1]],
+            [derivatives[dx + 1][dy + 1], derivatives[dx][dy + 2]],
+        ],
+    };
+    let xx = component(2, 0);
+    let xy = component(1, 1);
+    let yy = component(0, 2);
+    let jump = 2. * (0.5 * DYADIC_CUT_NORMAL_DEGREES.to_radians()).sin();
+    let detail = xx
+        .mul(xx)
+        .add(xy.mul(xy).scale(2.))
+        .add(yy.mul(yy))
+        .scale(36. * h * h / (jump * jump))
+        .add(FieldJet::constant(-1.))
+        .smoothstep();
+    (component(0, 0), detail)
 }
