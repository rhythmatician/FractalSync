+#[cfg(test)]
+mod coherent_field_tests {
+    use super::*;
+    fn jet(d: f64, h: f64) -> GeometryJet {
+        GeometryJet {
+            d,
+            grad_d: [0.; 2],
+            hessian_d: [[0.; 2]; 2],
+            resolved_scale: h,
+            requested_scale: GEOMETRY_SCALE_ALPHA * d,
+            estimated_error: 0.,
+            validity: GeometryValidity::Regular,
+            singularity: SingularityKind::None,
+            provider_version: GEOMETRY_PROVIDER_VERSION.to_string(),
+            tile_id: "coherent-fixture".to_string(),
+            is_bridge: false,
+        }
+    }
+    #[test]
+    fn agreeing_pair_does_not_hide_later_distance_change() {
+        let zero = FieldJet::constant(0.);
+        let mut f = FieldHierarchy::new(&jet(0.04, 0.0001), 1e-4, true, zero);
+        f.advance(&jet(0.04, 0.00005), 1e-4, true, zero);
+        f.advance(&jet(0.035, 0.000025), 1e-4, true, zero);
+        assert!(!f.closed);
+        f.advance(&jet(0.035, 0.0000125), 1e-4, true, zero);
+        assert!(!f.closed);
+        f.advance(&jet(0.035, 0.00000625), 1e-4, true, zero);
+        assert!(f.closed && f.certified);
+        assert_eq!(f.sum.d, 0.035);
+    }
+    #[test]
+    fn discarded_values_still_taint_a_dependent_gate() {
+        let zero = FieldJet::constant(0.);
+        let mut f = FieldHierarchy::new(&jet(0.04, 0.125), 1e-4, true, zero);
+        f.advance(&jet(0.04, 0.0625), 1e-4, false, zero);
+        f.advance(&jet(0.04, 0.03125), 1e-4, true, zero);
+        f.advance(&jet(0.04, 0.015625), 1e-4, true, zero);
+        assert!(!f.certified);
+        assert_eq!(f.effective_h, 0.03125);
+    }
+    #[test]
+    fn uncertified_zero_weight_lookahead_is_refused() {
+        for coarse_cert in [false, true] {
+            let zero = FieldJet::constant(0.);
+            let mut f = FieldHierarchy::new(&jet(0.04, 0.0001), 1e-4, coarse_cert, zero);
+            f.advance(&jet(0.04, 0.00005), 1e-4, false, zero);
+            f.advance(&jet(0.04, 0.000025), 1e-4, false, zero);
+            assert!(f.closed);
+            assert!(!f.certified);
+        }
+    }
+    fn field_at(x: f64) -> FieldJet {
+        let make = |a: f64, h: f64| GeometryJet {
+            d: a + 0.2 * x + 0.1 * x * x,
+            grad_d: [0.2 + 0.2 * x, 0.],
+            hessian_d: [[0.2, 0.], [0., 0.]],
+            resolved_scale: h,
+            requested_scale: 0.,
+            estimated_error: 0.,
+            ..jet(a, h)
+        };
+        let zero = FieldJet::constant(0.);
+        let mut f = FieldHierarchy::new(&make(0.04, 0.0007), 1e-4, true, zero);
+        for (a, h) in [
+            (0.0401, 0.00035),
+            (0.04015, 0.000175),
+            (0.0402, 0.0000875),
+            (0.0403, 0.00004375),
+        ] {
+            f.advance(&make(a, h), 1e-4, true, zero);
+        }
+        assert!(f.closed && f.certified);
+        f.sum
+    }
+    #[test]
+    fn refinement_weight_derivatives_match_the_scalar_field() {
+        let x = 0.00003;
+        let step = 1e-6;
+        let center = field_at(x);
+        let minus = field_at(x - step);
+        let plus = field_at(x + step);
+        assert!(((plus.d - minus.d) / (2. * step) - center.g[0]).abs() < 1e-8);
+        assert!(((plus.g[0] - minus.g[0]) / (2. * step) - center.h[0][0]).abs() < 1e-6);
+    }
+
+    #[test]
+    fn uncertified_disagreement_invalidates_a_partial_size_weight() {
+        let zero = FieldJet::constant(0.);
+        let mut f = FieldHierarchy::new(&jet(0.04, 0.0007), 1e-4, true, zero);
+        f.advance(&jet(0.04, 0.00035), 1e-4, true, zero);
+        f.advance(&jet(0.04, 0.000175), 1e-4, false, zero);
+        f.advance(&jet(0.04, 0.0000875), 1e-4, false, zero);
+        assert!(f.closed && !f.certified);
+    }
+    #[test]
+    fn partial_disagreement_with_uncertain_data_is_refused() {
+        let zero = FieldJet::constant(0.);
+        let mut f = FieldHierarchy::new(&jet(0.04, 0.0001), 1e-4, true, zero);
+        f.advance(&jet(0.04, 0.00005), 1e-4, true, zero);
+        f.advance(&jet(0.0403, 0.000025), 1e-4, false, zero);
+        assert!(!f.certified);
+    }
+
+    #[test]
+    fn uncertified_lookahead_cannot_certify_a_zero_refinement_plateau() {
+        let zero = FieldJet::constant(0.);
+        let mut f = FieldHierarchy::new(&jet(0.04, 0.0001), 1e-4, true, zero);
+        f.advance(&jet(0.04, 0.00005), 1e-4, false, zero);
+        f.advance(&jet(0.04, 0.000025), 1e-4, false, zero);
+        assert!(f.closed);
+        assert!(!f.certified, "Uncertified inputs selected the zero plateau");
+    }
+
+    #[test]
+    fn already_certified_closure_does_not_depend_on_later_unused_models() {
+        let zero = FieldJet::constant(0.);
+        let mut f = FieldHierarchy::new(&jet(0.04, 0.0001), 1e-4, true, zero);
+        f.advance(&jet(0.04, 0.00005), 1e-4, true, zero);
+        f.advance(&jet(0.04, 0.000025), 1e-4, true, zero);
+        assert!(f.closed && f.certified);
+        f.advance(&jet(0.03, 0.0000125), 1e-4, false, zero);
+        assert!(f.closed && f.certified);
+    }
+    #[test]
+    fn certified_size_saturation_can_dominate_unknown_disagreement() {
+        let zero = FieldJet::constant(0.);
+        let mut f = FieldHierarchy::new(&jet(0.04, 0.0011), 1e-4, true, zero);
+        f.advance(&jet(0.04, 0.00055), 1e-4, true, zero);
+        f.advance(&jet(0.04, 0.000275), 1e-4, false, zero);
+        assert!(!f.closed && f.certified);
+    }
+
+    #[test]
+    fn unused_outer_row_and_column_do_not_affect_the_field() {
+        let c = Complex64::new(0.39265, 0.05016);
+        let h = 0.0001;
+        let mut nodes: Vec<_> = distance_stencil(c, h)
+            .map(|p| {
+                (
+                    p.re - c.re,
+                    p.im - c.im,
+                    p.re * p.re + 0.3 * p.im * p.im + 0.2 * p.re * p.im,
+                )
+            })
+            .collect();
+        let (before, detail) = quintic_field(c, h, &nodes);
+        for i in 0..9 {
+            nodes[i].2 += 100.;
+            nodes[i * 9].2 -= 50.;
+        }
+        let (after, after_detail) = quintic_field(c, h, &nodes);
+        assert_eq!(before.d, after.d);
+        assert_eq!(before.g, after.g);
+        assert_eq!(before.h, after.h);
+        assert_eq!(detail.d, after_detail.d);
+        assert_eq!(detail.g, after_detail.g);
+        assert_eq!(detail.h, after_detail.h);
+    }
+    #[test]
+    fn quintic_reproduces_quadratics_and_derivatives() {
+        let c = Complex64::new(0.39265, 0.05016);
+        let h = 0.001;
+        let nodes: Vec<_> = distance_stencil(c, h)
+            .map(|p| {
+                (
+                    p.re - c.re,
+                    p.im - c.im,
+                    p.re * p.re + 0.3 * p.im * p.im + 0.2 * p.re * p.im,
+                )
+            })
+            .collect();
+        let (f, _) = quintic_field(c, h, &nodes);
+        assert!((f.d - (c.re * c.re + 0.3 * c.im * c.im + 0.2 * c.re * c.im)).abs() < 1e-13);
+        assert!((f.g[0] - (2. * c.re + 0.2 * c.im)).abs() < 1e-11);
+        assert!((f.g[1] - (0.6 * c.im + 0.2 * c.re)).abs() < 1e-11);
+        assert!((f.h[0][0] - 2.).abs() < 1e-8);
+        assert!((f.h[0][1] - 0.2).abs() < 1e-8);
+        assert!((f.h[1][1] - 0.6).abs() < 1e-8);
+    }
