@@ -0,0 +1,177 @@
+//! Reusable proof owner. Numerical proposals never become certificates by themselves.
+use super::super::{
+    BoundaryInterval, NodalSample, DYADIC_CUT_NORMAL_DEGREES, DYADIC_CUT_TIE_FACTOR,
+};
+use super::{
+    branch::cover, endpoint_distance_upper, finite, point_proof, propose, witness_candidates, C,
+};
+
+const MAX_TARGETS: usize = 17 * 17;
+
+pub(super) struct DistanceCover {
+    curve: cover::ClosedCover,
+}
+
+pub(super) struct CertifiedNode {
+    sample: NodalSample,
+    upper: f64,
+    axis: C,
+}
+
+impl DistanceCover {
+    /// Targets choose subdivision effort, never the canonical scalar value.
+    pub(super) fn build(center: C, targets: &[(C, f64)]) -> Option<Self> {
+        if !finite(center) || targets.is_empty() || targets.len() > MAX_TARGETS {
+            return None;
+        }
+        let lower_targets: Option<Vec<_>> = targets
+            .iter()
+            .map(|&(query, error)| {
+                if !finite(query) || !error.is_finite() || error <= 0. {
+                    return None;
+                }
+                let value = propose(query)?.distance;
+                Some((query, (value - error).max(0.).next_up()))
+            })
+            .collect();
+        let curve = cover::build(
+            center,
+            cover::Request {
+                radius: 0.999999,
+                root_radius: 0.999,
+                root_width: 0.002,
+                initial_edges: 512,
+                max_regions: 65536,
+            },
+            &lower_targets?,
+        )
+        .ok()?;
+        Some(Self { curve })
+    }
+
+    pub(super) fn sample(&self, query: C, error: f64) -> Option<CertifiedNode> {
+        if !finite(query) || !error.is_finite() || error <= 0. {
+            return None;
+        }
+        let proposal = propose(query)?;
+        let lower = self.curve.clearance(query).ok()?.lower();
+        if lower < (proposal.distance - error).next_up() {
+            return None;
+        }
+        // Floating membership only ranks candidates. A fresh directed proof at
+        // the exact represented endpoint is the sole exterior authority.
+        let mut upper = None;
+        'search: for window in [error * 0.25, error] {
+            let Some(candidates) = witness_candidates(query, window) else {
+                continue;
+            };
+            for (point, _, _) in candidates {
+                for precision in [128, 256] {
+                    if point_proof::escape([point.re, point.im], precision, 32768).is_some() {
+                        upper = endpoint_distance_upper(query, point);
+                        break 'search;
+                    }
+                }
+            }
+        }
+        let upper = upper?;
+        if lower > upper || upper > (proposal.distance + error).next_down() {
+            return None;
+        }
+        let value = -proposal.distance;
+        let sample = NodalSample::enclosed(
+            query,
+            value,
+            BoundaryInterval {
+                lo: (-upper).min(value),
+                hi: (-lower).max(value),
+            },
+        )?;
+        Some(CertifiedNode {
+            sample,
+            upper,
+            axis: proposal.boundary - query,
+        })
+    }
+
+    pub(super) fn direction_agrees(&self, node: &CertifiedNode, h: f64) -> bool {
+        if !h.is_finite() || h <= 0. {
+            return false;
+        }
+        let tie = (DYADIC_CUT_TIE_FACTOR * h).next_up();
+        let radius = (node.upper + tie).next_up();
+        self.curve
+            .boundary_direction_cone(
+                node.sample.query,
+                radius,
+                node.axis,
+                DYADIC_CUT_NORMAL_DEGREES.to_radians().cos(),
+            )
+            .is_some()
+    }
+}
+
+impl CertifiedNode {
+    pub(super) fn sample(&self) -> NodalSample {
+        self.sample
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn invalid_cover_requests_refuse_before_search() {
+        let q = C::new(0.3, 0.);
+        assert!(DistanceCover::build(q, &[]).is_none());
+        assert!(DistanceCover::build(q, &vec![(q, 1e-8); MAX_TARGETS + 1]).is_none());
+        for error in [0., -1., f64::NAN, f64::INFINITY] {
+            assert!(DistanceCover::build(q, &[(q, error)]).is_none());
+        }
+        assert!(DistanceCover::build(C::new(f64::NAN, 0.), &[(q, 1e-8)]).is_none());
+    }
+
+    #[test]
+    fn runtime_owned_cover_certifies_actual_query_centers() {
+        for (query, error, h) in [
+            (
+                C::new(0.32049988639807619, 0.04733531447355364),
+                5e-8,
+                2f64.powi(-20),
+            ),
+            (
+                C::new(0.35659381055433242, 0.06404656757776669),
+                5e-10,
+                2f64.powi(-27),
+            ),
+        ] {
+            let start = std::time::Instant::now();
+            let targets: Vec<_> = super::super::super::distance_stencil(query, h)
+                .map(|point| (point, error))
+                .collect();
+            let cover = DistanceCover::build(targets[40].0, &targets)
+                .expect("closed attracting cover");
+            let node = cover
+                .sample(query, error)
+                .expect("two-sided runtime-owned proof");
+            assert_eq!(
+                node.sample().value.to_bits(),
+                (-propose(query).unwrap().distance).to_bits()
+            );
+            assert_eq!(node.sample().query, query);
+            let refinement = (0..=4)
+                .find(|&level| cover.direction_agrees(&node, h * 2f64.powi(-level)))
+                .expect("bounded spatial refinement resolves direction coverage");
+            assert!(cover.sample(C::new(2., 0.), error).is_none());
+            for invalid in [0., -1., f64::NAN, f64::INFINITY] {
+                assert!(cover.sample(query, invalid).is_none());
+                assert!(!cover.direction_agrees(&node, invalid));
+            }
+            eprintln!(
+                "[RUNTIME_COVER145] query={query:?} spatial_refinement={refinement} elapsed_s={}",
+                start.elapsed().as_secs_f64()
+            );
+        }
+    }
+}
