+ #[test] fn affine_exterior_obeys_the_preupdate_escape_budget() {
+  let fixtures=[(511,0.2500375092511157),(512,0.25003736342837773),(513,0.2500372184543587)];
+  for (first_escape,c) in fixtures {
+   let mut z=0.;let mut detected=None;
+   for n in 0..=513 {if z*z>4. {detected=Some(n);break;} z=z*z+c;}
+   assert_eq!(detected,Some(first_escape));
+   let point=num_complex::Complex64::new(c,0.);
+   assert_eq!(crate::visual_metrics::mandelbrot_membership(point,512),first_escape>=512);
+   assert!(!crate::visual_metrics::mandelbrot_membership(point,32768));
+   assert_eq!(affine_box(c,0.,0.),if first_escape<512 {Some(false)} else {None});
+  }
+ }
+ #[test] fn affine_interior_proves_a_whole_period_three_box() {
+  let center=[-0.1225611668766536,0.7448617666197442];let width=1e-7;
+  let re=center[0]-width/2.;let im=center[1]-width/2.;
+  assert_eq!(affine_box(re,im,width),Some(true));
+  for y in 0..=8 {for x in 0..=8 {
+   let point=num_complex::Complex64::new(re+width*x as f64/8.,im+width*y as f64/8.);
+   for budget in [512,32768] {assert!(crate::visual_metrics::mandelbrot_membership(point,budget));}
+  }}
+ }
