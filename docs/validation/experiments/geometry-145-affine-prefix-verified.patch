+
 pub(super) fn affine_box(re0:f64,im0:f64,width:f64)->Option<bool> {
  if !re0.is_finite() || !im0.is_finite() || !width.is_finite() || width<0. {return None;}
  let re=Interval{lo:re0.next_down(),hi:(re0+width).next_up()};
  let im=Interval{lo:im0.next_down(),hi:(im0+width).next_up()};
  if !re.finite() || !im.finite() {return None;}
  affine_membership(re,im)
+}
+
+fn periodic_trap(z:[f64;2],radius:f64,centers:&[[f64;2]],c:[f64;2],cr:f64)->Option<bool> {
+ let last=centers.len().checked_sub(1)?;
+ let mut period=1;let mut separation=f64::INFINITY;
+ for p in 1..=last {let distance=distance_upper(z,centers[last-p]);if distance<separation {period=p;separation=distance;}}
+ for factor in [2.,8.,32.,128.] {
+  let r=upper_mul(factor,upper_add(radius,separation));let start=Ball{z,radius:r};
+  if !start.bounded() {continue;}
+  let mut end=start;let mut bounded=true;
+  // The parameter box is fixed throughout this return; intermediate disks
+  // must remain bounded as well as the final disk lying strictly inside.
+  for _ in 0..period {let Some(next)=end.step(c,cr) else {bounded=false;break;};end=next;bounded &=end.bounded();}
+  if bounded && upper_add(distance_upper(end.z,start.z),end.radius)<r {return Some(true);}
+ }
+ None
+}
+fn machine_round_error(a:f64,c_bound:f64)->f64 {
+ // Encloses componentwise complex square/add rounding for both the actual
+ // machine update and the rounded center, including underflow allowances.
+ upper_add(upper_mul(32.*f64::EPSILON,upper_add(upper_mul(a,a),c_bound)),32.*f64::MIN_POSITIVE)
 }
 
