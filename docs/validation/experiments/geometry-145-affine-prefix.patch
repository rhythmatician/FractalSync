+fn affine_membership(re:Interval, im:Interval)->Option<bool> {
+ let c=[re.lo+(re.hi-re.lo)*0.5,im.lo+(im.hi-im.lo)*0.5];
+ if !c.iter().all(|x|x.is_finite()) {return None;}
+ let cr=norm_upper([(re.lo-c[0]).abs().max((re.hi-c[0]).abs()).next_up(),
+                    (im.lo-c[1]).abs().max((im.hi-c[1]).abs()).next_up()]);
+ let mut z=[0.;2];let mut d=[0.;2];let mut remainder=0.;
+ let mut centers=vec![z];let mut all_bounded=true;
+ let mut radius=0.;
+ for n in 1..=512 {
+  let magnitude=norm_upper(z);let sensitivity=norm_upper(d);
+  let total=upper_add(upper_mul(sensitivity,cr),remainder);
+  let a=upper_add(magnitude,total);
+  let cb=upper_add(norm_upper(c),cr);
+  // Bounds both the machine critical-orbit update and center update.
+  let round=upper_add(upper_mul(32.*f64::EPSILON,upper_add(upper_mul(a,a),cb)),32.*f64::MIN_POSITIVE);
+  let next=[z[0]*z[0]-z[1]*z[1]+c[0],2.*z[0]*z[1]+c[1]];
+  let next_d=[2.*(z[0]*d[0]-z[1]*d[1])+1.,2.*(z[0]*d[1]+z[1]*d[0])];
+  let p=Interval::point;
+  let dr=p(2.).mul(p(z[0]).mul(p(d[0])).sub(p(z[1]).mul(p(d[1])))).add(p(1.));
+  let di=p(2.).mul(p(z[0]).mul(p(d[1])).add(p(z[1]).mul(p(d[0]))));
+  let de=dr.sub(p(next_d[0]));let ie=di.sub(p(next_d[1]));
+  let coefficient_error=de.square().add(ie.square()).hi.sqrt().next_up();
+  remainder=upper_add(upper_add(upper_mul(upper_mul(2.,magnitude),remainder),upper_mul(total,total)),
+     upper_add(round,upper_mul(coefficient_error,cr)));
+  z=next;d=next_d;
+  radius=upper_add(upper_mul(norm_upper(d),cr),remainder);
+  if !radius.is_finite() || radius>4. || !z.iter().all(|x|x.is_finite()) {return None;}
+  let low=p(z[0]).square().add(p(z[1]).square()).lo.max(0.).sqrt().next_down();
+  if n<512 && (low-radius).next_down()>2. {return Some(false);}
+  all_bounded &= Ball{z,radius}.bounded();
+  centers.push(z);
+ }
+ if !all_bounded {return None;}
+ let mut period=1;let mut separation=f64::INFINITY;
+ for p in 1..=512 {let distance=distance_upper(z,centers[512-p]);if distance<separation {period=p;separation=distance;}}
+ for factor in [2.,8.,32.,128.] {
+  let r=upper_mul(factor,upper_add(radius,separation));let start=Ball{z,radius:r};
+  if !start.bounded() {continue;}
+  let mut end=start;let mut bounded=true;
+  for _ in 0..period {let Some(next)=end.step(c,cr) else {bounded=false;break;};end=next;bounded &=end.bounded();}
+  if bounded && upper_add(distance_upper(end.z,start.z),end.radius)<r {return Some(true);}
+ }
+ None
+}
+pub(super) fn affine_box(re0:f64,im0:f64,width:f64)->Option<bool> {
+ if !re0.is_finite() || !im0.is_finite() || !width.is_finite() || width<0. {return None;}
+ let re=Interval{lo:re0.next_down(),hi:(re0+width).next_up()};
+ let im=Interval{lo:im0.next_down(),hi:(im0+width).next_up()};
+ if !re.finite() || !im.finite() {return None;}
+ affine_membership(re,im)
+}
