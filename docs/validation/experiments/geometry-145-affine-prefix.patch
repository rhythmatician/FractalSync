+#[cfg(test)] mod affine_tests {
+ use super::*;
+ #[test] fn recorded_training_box_is_provably_outside() {
+  let c=[0.3075204398270623,0.02876420131721053];
+  let width=56.*2f64.powi(-22);
+  let re=c[0]-width/2.;let im=c[1]-width/2.;
+  assert_eq!(affine_box(re,im,width),Some(false));
+  for y in 0..=16 {for x in 0..=16 {
+   let point=num_complex::Complex64::new(re+width*x as f64/16.,im+width*y as f64/16.);
+   for budget in [512,32768] {assert!(!crate::visual_metrics::mandelbrot_membership(point,budget));}
+  }}
+ }
+ #[test] fn affine_certificates_match_independent_ordinary_nodes() {
+  let mut accepted=0;
+  for y in -10..=10 {for x in -15..=5 {
+   let re=x as f64/8.;let im=y as f64/8.;let width=1./64.;
+   let Some(expected)=affine_box(re,im,width) else {continue;};accepted+=1;
+   for (dx,dy) in [(0.,0.),(1.,0.),(0.,1.),(1.,1.),(0.5,0.5)] {
+    let c=num_complex::Complex64::new(re+dx*width,im+dy*width);
+    for budget in [512,32768] {assert_eq!(crate::visual_metrics::mandelbrot_membership(c,budget),expected,"{c:?}");}
+   }
+  }}
+  assert!(accepted>100);
+ }
+ #[test] fn neutral_and_invalid_boxes_cannot_supply_affine_certificates() {
+  for x in [0.25,0.2500001,-0.75] {assert_eq!(affine_box(x,0.,0.),None);}
+  for (x,y,w) in [(f64::NAN,0.,1.),(0.,f64::INFINITY,1.),(0.,0.,-1.),(f64::MAX,0.,f64::MAX)] {
+   assert_eq!(affine_box(x,y,w),None);
+  }
+ }
