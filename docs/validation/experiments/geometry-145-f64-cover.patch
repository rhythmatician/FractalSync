+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn request() -> Request {
+        Request {
+            radius: 0.5,
+            root_radius: 0.5,
+            root_width: 0.25,
+            initial_edges: 8,
+            max_regions: 1024,
+        }
+    }
+    #[test]
+    fn capsule_radius_and_orientation_bounds_are_not_optional() {
+        let zero = C::new(0., 0.);
+        let capsule = Capsule {
+            a: C::new(1., -1.),
+            b: C::new(1., 1.),
+            radius: 0.25,
+        };
+        let lower = distance_lower(capsule, zero).unwrap();
+        assert!(lower <= 0.75 && lower > 0.749999999999);
+        assert_eq!(
+            crossing(C::new(-1., -1.), C::new(1., 1.), zero),
+            Err(Refusal::Orientation)
+        );
+        assert!(distance_lower(
+            Capsule {
+                radius: f64::NAN,
+                ..capsule
+            },
+            zero
+        )
+        .is_err());
+        assert!(distance_lower(capsule, C::new(f64::INFINITY, 0.)).is_err());
+    }
+    #[test]
+    fn unclosed_paths_and_non_attracting_segments_refuse() {
+        let zero = C::new(0., 0.);
+        let cover = build_seeded(zero, zero, zero, 1, request(), &[(zero, 0.)]).unwrap();
+        let mut edges = cover.edges;
+        let last = edges.pop().unwrap();
+        edges.push(edge(last.patch, last.start, last.end * 0.999999).unwrap());
+        assert!(closed(edges, &[(zero, 0.)]).is_err());
+        let mu = C::new(1.1, 0.);
+        let z = mu * 0.5;
+        let c = mu * 0.5 - mu * mu * 0.25;
+        let (patch, _) = certify_auto(z, c, mu, 1, 0.01).unwrap();
+        assert!(edge(patch, mu, mu + C::new(0., 0.001)).is_err());
+    }
+    #[test]
+    fn exhausted_or_invalid_requests_never_return_a_prefix_cover() {
+        let zero = C::new(0., 0.);
+        let cover = build_seeded(zero, zero, zero, 1, request(), &[(zero, 0.)]).unwrap();
+        assert!(closed(cover.edges, &[(zero, 0.3)]).is_err());
+        let mut r = request();
+        r.max_regions = 8;
+        let failure = match build_seeded(zero, zero, zero, 1, r, &[(zero, 0.18)]) {
+            Err(f) => f,
+            Ok(_) => panic!("budget returned prefix"),
+        };
+        assert_eq!(failure.reason, Refusal::Work);
+        assert!(failure.attempted <= 8);
+        for minimum in [-1., f64::NAN, f64::INFINITY] {
+            assert!(build_seeded(zero, zero, zero, 1, request(), &[(zero, minimum)]).is_err());
+        }
+        assert!(build_seeded(zero, zero, zero, 1, request(), &[(zero, 0.3)]).is_err());
+    }
+    #[test]
+    fn cardioid_closed_curve_bounds_and_reuses_queries() {
+        let origin = C::new(0., 0.);
+        let cover = build_seeded(origin, origin, origin, 1, request(), &[(origin, 0.15)]).unwrap();
+        let proof = cover.clearance(origin).unwrap();
+        assert!(proof.lower > 0.15 && proof.lower < 0.1875 && proof.winding == 1);
+        assert!(cover.clearance(C::new(0.01, 0.)).unwrap().lower > 0.14);
+        assert!(cover.clearance(C::new(2., 0.)).is_err());
+    }
+    #[test]
+    fn high_period_generic_closed_covers() {
+        for (q, minimum) in [
+            (
+                C::new(0.32049988639807619, 0.04733531447355364),
+                7.64252680245677e-6 - 5e-8,
+            ),
+            (
+                C::new(0.35659381055433242, 0.06404656757776669),
+                1.728681342294706e-7 - 5e-10,
+            ),
+        ] {
+            let start = std::time::Instant::now();
+            let r = Request {
+                radius: 0.999999,
+                root_radius: 0.99,
+                root_width: 0.025,
+                initial_edges: 128,
+                max_regions: 65536,
+            };
+            let result = build(q, r, &[(q, minimum)]);
+            eprintln!(
+                "[F64_COVER145] q={q:?} result={:?} elapsed_s={}",
+                result
+                    .as_ref()
+                    .map(|c| (c.edge_count(), c.clearance(q).unwrap())),
+                start.elapsed().as_secs_f64()
+            );
+            assert!(result.is_ok());
+        }
+    }
+}
