+fn capsule_axis_cosine_lower(cap: Capsule, q: C, axis: C) -> Option<f64> {
+    let p = I::point;
+    let ax = p(cap.a.re).sub(p(q.re));
+    let ay = p(cap.a.im).sub(p(q.im));
+    let bx = p(cap.b.re).sub(p(q.re));
+    let by = p(cap.b.im).sub(p(q.im));
+    let adot = ax.mul(p(axis.re)).add(ay.mul(p(axis.im)));
+    let bdot = bx.mul(p(axis.re)).add(by.mul(p(axis.im)));
+    let axis_norm = norm(axis);
+    let remainder = (cap.radius * axis_norm).next_up();
+    let numerator = (adot.lo.min(bdot.lo) - remainder).next_down();
+    let across = ax.mul(p(axis.im)).sub(ay.mul(p(axis.re)));
+    let bcross = bx.mul(p(axis.im)).sub(by.mul(p(axis.re)));
+    let cross_upper = up_add(across.abs_upper().max(bcross.abs_upper()), remainder);
+    if numerator <= 0. || !numerator.is_finite() || !cross_upper.is_finite() {
+        return None;
+    }
+    let tangent = (cross_upper / numerator).next_up();
+    let denominator = up_add(1., (tangent * tangent).next_up()).sqrt().next_up();
+    let lower = (1. / denominator).next_down();
+    (denominator.is_finite() && lower.is_finite()).then_some(lower)
