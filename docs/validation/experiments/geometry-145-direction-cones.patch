+// Subdivide only the affine capsule representation. Both children include the
+// midpoint rounding error, so their union covers the original capsule.
+fn capsule_direction_cone(
+    cap: Capsule,
+    q: C,
+    radius: f64,
+    axis: C,
+    threshold: f64,
+    depth: u32,
+    work: &mut usize,
+) -> Option<(f64, usize)> {
+    *work += 1;
+    if *work > 65536 {
+        return None;
+    }
+    if distance_lower(cap, q).ok()? > radius {
+        return Some((f64::INFINITY, 0));
+    }
+    if let Some(lower) = capsule_axis_cosine_lower(cap, q, axis) {
+        if lower > threshold {
+            return Some((lower, 1));
+        }
+    }
+    if depth >= 12 {
+        return None;
+    }
+    let mid = cap.a * 0.5 + cap.b * 0.5;
+    if mid == cap.a || mid == cap.b || !finite(mid) {
+        return None;
+    }
+    let p = I::point;
+    let error = super::round(
+        mid,
+        p(cap.a.re).mul(p(0.5)).add(p(cap.b.re).mul(p(0.5))),
+        p(cap.a.im).mul(p(0.5)).add(p(cap.b.im).mul(p(0.5))),
+    );
+    let child_radius = up_add(cap.radius, error);
+    let (a, na) = capsule_direction_cone(
+        Capsule {
+            a: cap.a,
+            b: mid,
+            radius: child_radius,
+        },
+        q,
+        radius,
+        axis,
+        threshold,
+        depth + 1,
+        work,
+    )?;
+    let (b, nb) = capsule_direction_cone(
+        Capsule {
+            a: mid,
+            b: cap.b,
+            radius: child_radius,
+        },
+        q,
+        radius,
+        axis,
+        threshold,
+        depth + 1,
+        work,
+    )?;
+    Some((a.min(b), na + nb))
