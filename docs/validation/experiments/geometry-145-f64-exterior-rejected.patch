+#[cfg(test)]
+pub(super) fn proposal_exterior_witness(c:[f64;2],budget:usize)->Option<usize> {
+    if !c.iter().all(|x|x.is_finite())||norm_upper(c)>2.||budget>32768 {return None;}
+    let mut orbit=Ball{z:[0.;2],radius:0.};
