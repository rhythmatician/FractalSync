+    }
+    #[test]
+    fn endpoint_enclosures_cover_exact_cardioid_and_glue_cycle_phases() {
+        let mu = C::new(-0.5, 0.5);
+        let z = mu * 0.5;
+        let c = mu * 0.5 - mu * mu * 0.25;
+        let proof = certify(z, c, mu, 1, [1e-3, 1e-6, 1e-6]).unwrap();
+        for delta in [C::new(2f64.powi(-12), 0.), C::new(0., -2f64.powi(-12))] {
+            let parameter = mu + delta;
+            let exact = [
+                parameter * 0.5,
+                parameter * 0.5 - parameter * parameter * 0.25,
+            ];
+            let values = proof.at(parameter).unwrap();
+            for i in 0..2 {
+                assert!(norm(exact[i] - values[i].0) <= values[i].1);
+            }
+        }
+        assert!(proof.at(mu + C::new(0.01, 0.)).is_none());
+        let mu = C::new(-0.5, 0.2);
+        let c = C::new(-1., 0.) + mu * 0.25;
+        let mut z = C::new(0., 0.);
+        for _ in 0..4096 {
+            z = z * z + c;
+        }
+        let a = certify(z, c, mu, 2, [1e-4, 1e-7, 1e-7]).unwrap();
+        let b = certify(z * z + c, c, mu, 2, [1e-4, 1e-7, 1e-7]).unwrap();
+        assert_eq!(glue(&a, &b, mu), Some(1));
+    }
+    #[test]
+    fn branch_identity_requires_containment_and_matching_components() {
