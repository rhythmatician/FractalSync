+            certify(z, c, mu, 1, [2e-4, 1e-7, 1e-7]).unwrap()
+        };
+        let a = make(C::new(-0.4, 0.6));
+        let b = make(C::new(-0.4, 0.6001));
+        assert_eq!(glue(&a, &b, C::new(-0.4, 0.60005)), Some(0));
+        assert_eq!(glue(&a, &b, C::new(0., 0.)), None);
+        assert_eq!(glue(&a, &b, C::new(f64::NAN, 0.)), None);
+        let make3 = |seed: C| {
