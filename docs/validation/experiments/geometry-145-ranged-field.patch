+#[derive(Clone,Copy)]
+pub(super) struct RangeJet {
+    pub(super) d:I,
+    pub(super) g:[I;2],
+    pub(super) h:[[I;2];2],
+}
+impl RangeJet {
+    fn invalid()->Self {Self::exact(f64::NAN,[f64::NAN;2],[[f64::NAN;2];2])}
+    fn well_formed(self)->bool {
+        let contains_finite=|v:I|v.lo<=v.hi && v.lo<f64::INFINITY && v.hi>f64::NEG_INFINITY;
+        contains_finite(self.d) && self.g.iter().chain(self.h.iter().flatten()).all(|v|contains_finite(*v))
+    }
+    pub(super) fn constant(d:f64)->Self {Self{d:I::point(d),g:[I::point(0.);2],h:[[I::point(0.);2];2]}}
+    pub(super) fn exact(d:f64,g:[f64;2],h:[[f64;2];2])->Self {
+        Self{d:I::point(d),g:g.map(I::point),h:h.map(|row|row.map(I::point))}
+    }
+    pub(super) fn is_constant(self,value:f64)->bool {
+        self.d.lo==value && self.d.hi==value && self.g.iter().chain(self.h.iter().flatten()).all(|v|v.lo==0. && v.hi==0.)
+    }
+    pub(super) fn add(self,other:Self)->Self {
+        if !self.well_formed() || !other.well_formed() {return Self::invalid();}
+        if self.is_constant(0.) {return other;}
+        if other.is_constant(0.) {return self;}
+        if self.d.lo.is_finite() && self.is_constant(-other.d.lo) && other.is_constant(other.d.lo) {return Self::constant(0.);}
+        Self{d:self.d.add(other.d),g:std::array::from_fn(|i|self.g[i].add(other.g[i])),
+            h:std::array::from_fn(|i|std::array::from_fn(|j|self.h[i][j].add(other.h[i][j])))}
+    }
+    pub(super) fn scale(self,factor:f64)->Self {self.mul(Self::constant(factor))}
+    pub(super) fn mul(self,other:Self)->Self {
+        if !self.well_formed() || !other.well_formed() {return Self::invalid();}
+        if self.is_constant(0.) || other.is_constant(0.) {return Self::constant(0.);}
+        if self.is_constant(1.) {return other;}
+        if other.is_constant(1.) {return self;}
+        Self{d:self.d.mul(other.d),g:std::array::from_fn(|i|self.g[i].mul(other.d).add(self.d.mul(other.g[i]))),
+            h:std::array::from_fn(|i|std::array::from_fn(|j|self.h[i][j].mul(other.d)
+                .add(self.g[i].mul(other.g[j])).add(self.g[j].mul(other.g[i])).add(self.d.mul(other.h[i][j]))))}
+    }
