+    fn compose(self,value:I,first:I,second:I)->Self {
+        Self{d:value,g:self.g.map(|v|first.mul(v)),
+            h:std::array::from_fn(|i|std::array::from_fn(|j|first.mul(self.h[i][j]).add(second.mul(self.g[i]).mul(self.g[j]))))}
+    }
+    pub(super) fn reciprocal_positive(self)->Option<Self> {
+        if !self.d.finite() || self.d.lo<=0. {return None;}
+        let square=self.d.square();let cube=square.mul(self.d);
+        if !square.finite() || square.lo<=0. || !cube.finite() || cube.lo<=0. {return None;}
+        let inverse=I::point(1.).div_positive(self.d);
+        let first=I::point(-1.).div_positive(square);
+        let second=I::point(2.).div_positive(cube);
+        Some(self.compose(inverse,first,second))
+    }
+    pub(super) fn sqrt_positive(self)->Option<Self> {
+        if !self.d.finite() || self.d.lo<=0. {return None;}
+        let value=I{lo:self.d.lo.sqrt().next_down(),hi:self.d.hi.sqrt().next_up()};
+        if value.lo<=0. {return None;}
+        let denominator=self.d.mul(value);
+        if !denominator.finite() || denominator.lo<=0. {return None;}
+        Some(self.compose(value,I::point(0.5).div_positive(value),I::point(-0.25).div_positive(denominator)))
+    }
+    pub(super) fn smoothstep(self)->Self {
+        if !self.well_formed() || !self.d.finite() {return Self::invalid();}
+        if self.d.hi<=0. {return Self::constant(0.);}
+        if self.d.lo>=1. {return Self::constant(1.);}
+        let x=I{lo:self.d.lo.max(0.),hi:self.d.hi.min(1.)};
+        let p=I::point;
+        let value=x.square().mul(x).mul(p(10.).add(p(-15.).mul(x)).add(p(6.).mul(x.square())));
+        let first=p(30.).mul(x.square()).mul(x.sub(p(1.)).square());
+        let second=p(60.).mul(x).mul(p(2.).mul(x.square()).add(p(-3.).mul(x)).add(p(1.)));
+        self.compose(value,first,second)
+    }
+    // Test the scalar plateau before forming derivatives. A certified plateau
+    // removes every derivative dependency, even if those bounds are unknown.
+    pub(super) fn size_weight(self,h:f64,epsilon:f64,alpha:f64)->Option<Self> {
+        if !h.is_finite() || h<=0. || !epsilon.is_finite() || epsilon<=0. || !alpha.is_finite() || alpha<=0. {return None;}
+        if !self.well_formed() || !self.d.finite() {return None;}
