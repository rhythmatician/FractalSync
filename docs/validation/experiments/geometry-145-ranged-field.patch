+    #[test] fn smoothstep_crossing_plateaus_encloses_constant_branch_derivatives() {
+        let x=RangeJet{d:I{lo:-0.1,hi:1.1},g:[I::point(2.);2],h:[[I::point(3.);2];2]}.smoothstep();
+        assert!(encloses(x.d,0.) && encloses(x.d,1.));
+        assert!(encloses(x.g[0],0.) && encloses(x.h[0][0],0.));
+    }
+    #[test] fn differential_uncertainty_is_scaled_into_the_existing_error_units() {
+        let x=RangeJet{d:I{lo:-1e-13,hi:1e-13},g:[I{lo:-1e-8,hi:1e-8};2],h:[[I{lo:-1e-2,hi:1e-2};2];2]};
+        let error=x.error(0.,[0.;2],[[0.;2];2],1e-5);
+        assert!(error>=2e-12 && error<2.1e-12);
+    }
+    #[test] fn invalid_domains_cannot_supply_a_finite_certificate() {
+        assert!(RangeJet::constant(0.).reciprocal_positive().is_none());
+        assert!(RangeJet::constant(-1.).sqrt_positive().is_none());
+        assert!(RangeJet::constant(1.).size_weight(1.,0.,0.1).is_none());
+        assert!(RangeJet::constant(1e-300).reciprocal_positive().is_none());
+        assert!(RangeJet::constant(1e-300).sqrt_positive().is_none());
+        assert!(!RangeJet::constant(0.).mul(RangeJet::invalid()).finite());
+        assert!(!RangeJet::invalid().smoothstep().finite());
+        assert!(!RangeJet::exact(f64::NAN,[0.;2],[[0.;2];2]).error(0.,[0.;2],[[0.;2];2],1.).is_finite());
+    }
+    #[test] fn nonfinite_comparison_jets_cannot_supply_finite_errors() {
+        for invalid in [f64::NAN,f64::INFINITY,f64::NEG_INFINITY] {
+            assert!(!RangeJet::constant(0.).error(invalid,[0.;2],[[0.;2];2],1.).is_finite());
+            assert!(!RangeJet::constant(0.).error(0.,[invalid,0.],[[0.;2];2],1.).is_finite());
+            assert!(!RangeJet::constant(0.).error(0.,[0.;2],[[invalid;2];2],1.).is_finite());
+        }
+    }
+    #[test] fn invalid_operands_cannot_be_cancelled_to_finite_zero() {
+        for invalid in [f64::NAN,f64::INFINITY,f64::NEG_INFINITY] {
+            assert!(!RangeJet::constant(0.).mul(RangeJet::constant(invalid)).finite());
+            assert!(!RangeJet::constant(0.).mul(RangeJet::exact(0.,[invalid;2],[[0.;2];2])).finite());
+            assert!(!RangeJet::constant(0.).mul(RangeJet::exact(0.,[0.;2],[[invalid;2];2])).finite());
+        }
+        let reversed=RangeJet{d:I{lo:2.,hi:1.},..RangeJet::constant(0.)};
+        assert!(!RangeJet::constant(0.).mul(reversed).finite());
+    }
+    #[test] fn uncertain_nodal_values_enclose_affine_fields_and_their_derivatives() {
+        let h=2f64.powi(-10);let delta=1e-10;
+        for c in [[0.37*h,0.61*h],[-2.3*h,3.2*h],[h.next_down(),0.],[h,0.],[h.next_up(),0.]] {
+            let cell=[(c[0]/h).floor(),(c[1]/h).floor()];
+            let mut nodes=Vec::new();
+            for y in -4..=4 {for x in -4..=4 {
+                let value=0.001+0.2*(cell[0]+x as f64)*h+0.1*(cell[1]+y as f64)*h;
+                nodes.push(I{lo:(value-delta).next_down(),hi:(value+delta).next_up()});
+            }}
+            let range=quintic(c,h,&nodes).unwrap();
+            for offset in [-delta*0.5,0.,delta*0.5] {for dx in [-delta/(32.*h),delta/(32.*h)] {for dy in [-delta/(32.*h),delta/(32.*h)] {
+                let d=0.001+0.2*c[0]+0.1*c[1]+offset+dx*(c[0]-cell[0]*h)+dy*(c[1]-cell[1]*h);
+                assert!(encloses(range.d,d));assert!(encloses(range.g[0],0.2+dx));assert!(encloses(range.g[1],0.1+dy));
+                assert!(range.h.iter().flatten().all(|v|encloses(*v,0.)));
+            }}}
+        }
+    }
