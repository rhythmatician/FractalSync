+pub(super) fn quintic(c:[f64;2],h:f64,nodes:&[I])->Option<RangeJet> {
+    if nodes.len()!=81 || !c.iter().all(|v|v.is_finite()) || !h.is_finite() || h<=0. || !nodes.iter().all(|v|v.finite()) {return None;}
+    let t=[c[0]/h-(c[0]/h).floor(),c[1]/h-(c[1]/h).floor()];
+    let basis=|t:f64|->[[I;6];3] {std::array::from_fn(|derivative|std::array::from_fn(|basis| {
+        let mut value=I::point(0.);
+        for power in (derivative..6).rev() {
+            let factor=(0..derivative).fold(1.,|product,i|product*(power-i) as f64);
+            value=value.mul(I::point(t)).add(I::point(QUINTIC_BASIS[basis][power]).mul(I::point(factor)));
+        }
+        value.div_positive(I::point(120.))
+    }))};
+    let wx=basis(t[0]);let wy=basis(t[1]);
+    let reference=nodes[40];
+    let sx=nodes[41].sub(nodes[39]).mul(I::point(0.5));
+    let sy=nodes[49].sub(nodes[31]).mul(I::point(0.5));
+    let mut derivatives=[[I::point(0.);3];3];
+    for y in 0..6 {for x in 0..6 {
+        let index=(y+2)*9+x+2;let center=nodes[index];
+        let laplacian=nodes[index-1].sub(center).add(nodes[index+1].sub(center))
+            .add(nodes[index-9].sub(center)).add(nodes[index+9].sub(center));
+        let coefficient=center.sub(I::point(0.25).mul(laplacian)).sub(reference)
+            .sub(sx.mul(I::point(x as f64-2.))).sub(sy.mul(I::point(y as f64-2.)));
+        for dx in 0..3 {for dy in 0..3-dx {
+            let denominator=(0..dx+dy).fold(I::point(1.),|value,_|value.mul(I::point(h)));
+            if !denominator.finite() || denominator.lo<=0. {return None;}
+            derivatives[dx][dy]=derivatives[dx][dy].add(wx[dx][x].mul(wy[dy][y]).mul(coefficient).div_positive(denominator));
+        }}
+    }}
+    derivatives[0][0]=derivatives[0][0].add(reference).add(sx.mul(I::point(t[0]))).add(sy.mul(I::point(t[1])));
+    derivatives[1][0]=derivatives[1][0].add(sx.div_positive(I::point(h)));
+    derivatives[0][1]=derivatives[0][1].add(sy.div_positive(I::point(h)));
+    let result=RangeJet{d:derivatives[0][0],g:[derivatives[1][0],derivatives[0][1]],
+        h:[[derivatives[2][0],derivatives[1][1]],[derivatives[1][1],derivatives[0][2]]]};
+    result.finite().then_some(result)
+}
