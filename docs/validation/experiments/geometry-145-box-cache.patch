+   let expected=membership_using(x,y,w,None);
+   assert_eq!(membership_using(x,y,w,Some(&cache)),expected);
+   assert_eq!(membership_using(x,y,w,Some(&cache)),expected);
+  }}
+ }
+ #[test] fn uncertain_boxes_are_retained_as_uncertain_cache_entries() {
