+#[cfg(test)] mod memo_tests {
+ use super::*;
+ #[test] fn exact_box_cache_matches_disabled_and_evicted_results() {
+  let cache=super::super::RwLock::new(super::super::LruCache::new(1));
+  let fixtures=[(-0.1,-0.1,0.2),(0.8,0.5,0.1),(0.25,0.,0.),(0.25f64.next_up(),0.,0.),(0.32049988639807619,0.04733531447355364,1e-8)];
