+#[cfg(test)] mod centered_node_tests {
+ use super::*;
+ #[test] fn sized_query_tile_reconstructs_the_original_generator() {
+  let c=Complex64::new(0.3,0.05);let k=8;let h=dyadic_h(k);
+  let (_,_,re,im)=dyadic_tile_origin(c,h);
+  let old=generate_shore_tile(k,h,re,im).unwrap();
+  let new=generate_shore_tile_sized(k,h,re,im,DYADIC_TILE_NODES).unwrap();
+  assert_eq!(old.unstable_nodes,new.unstable_nodes);assert_eq!(old.segments.len(),new.segments.len());
+  for (a,b) in old.segments.iter().zip(&new.segments) {assert_eq!(a.p1,b.p1);assert_eq!(a.p2,b.p2);assert_eq!(a.normal,b.normal);}
+ }
+ #[test] fn centered_scalar_tiles_never_supply_uncontained_or_unstable_values() {
+  for c in [Complex64::new(0.3,0.05),Complex64::new(0.35,0.05),Complex64::new(0.4,0.05)] {
+   for k in [5,8,11] {for nodes in [17,33,57] {
+    if let Some((tile,stable))=centered_node_sample(c,k,nodes) {
+     assert_eq!(stable,point_membership_stable(c,&tile));
+     let width=(nodes-1) as f64*tile.h;
+     let margin=(c.re-tile.origin_re).min(tile.origin_re+width-c.re)
+      .min(c.im-tile.origin_im).min(tile.origin_im+width-c.im);
+     assert!(nearest_shore_distance(c,&tile)+DYADIC_STABILITY_BAND_CELLS as f64*tile.h<margin);
+    }
+   }}
+  }
+ }
+ #[test] fn recorded_next_driven_point_resolves() {
+  let jet=query_geometry(Complex64::new(0.32049988639807619,0.04733531447355364),1e-4).unwrap();
+  assert_eq!(jet.validity,GeometryValidity::Regular,"{jet:?}");
+  assert!(jet.resolved_scale<=jet.requested_scale);
+  assert!(jet.estimated_error<=DYADIC_FIT_ERROR_FACTOR*jet.requested_scale);
+ }
