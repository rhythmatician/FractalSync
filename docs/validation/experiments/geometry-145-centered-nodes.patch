+// A nodal coefficient needs one distance, rather than the complete 9x9
+// derivative stencil required by a public query. The four-cell uncertainty
+// band is retained; unseen contours must remain beyond that same margin.
+fn centered_node_sample(c:Complex64,k:u32,n:usize)->Option<(ShoreTile,bool)> {
+ let h=dyadic_h(k);let half=(n/2) as f64;
+ let origin=[((c.re/h).floor()-half)*h,((c.im/h).floor()-half)*h];
+ let tile=generate_shore_tile_sized(k,h,origin[0],origin[1],n)?;
+ if tile.segments.is_empty() {return None;}
+ let width=(n-1) as f64*h;
+ let margin=(c.re-origin[0]).min(origin[0]+width-c.re)
+     .min(c.im-origin[1]).min(origin[1]+width-c.im);
+ let contained=nearest_shore_distance(c,&tile)+DYADIC_STABILITY_BAND_CELLS as f64*h<margin;
+ contained.then(||{let stable=point_membership_stable(c,&tile);(tile,stable)})
+}
