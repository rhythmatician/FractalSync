+//! Outward-rounded intervals shared by the geometry certificates.
+
+#[derive(Clone, Copy)]
+pub(super) struct Interval {
+    pub(super) lo: f64,
+    pub(super) hi: f64,
+}
+
+impl Interval {
+    pub(super) fn point(value: f64) -> Self {
+        Self {
+            lo: value,
+            hi: value,
+        }
+    }
+
+    pub(super) fn add(self, other: Self) -> Self {
+        Self {
+            lo: (self.lo + other.lo).next_down(),
+            hi: (self.hi + other.hi).next_up(),
+        }
+    }
+
+    pub(super) fn sub(self, other: Self) -> Self {
+        Self {
+            lo: (self.lo - other.hi).next_down(),
+            hi: (self.hi - other.lo).next_up(),
+        }
+    }
+
+    pub(super) fn mul(self, other: Self) -> Self {
+        let products = [
+            self.lo * other.lo,
+            self.lo * other.hi,
+            self.hi * other.lo,
+            self.hi * other.hi,
+        ];
+        Self {
+            lo: products
+                .iter()
+                .copied()
+                .fold(f64::INFINITY, f64::min)
+                .next_down(),
+            hi: products
+                .iter()
+                .copied()
+                .fold(f64::NEG_INFINITY, f64::max)
+                .next_up(),
+        }
+    }
+
+    pub(super) fn square(self) -> Self {
+        let lo = if self.lo <= 0.0 && self.hi >= 0.0 {
+            0.0
+        } else {
+            self.lo.abs().min(self.hi.abs()).powi(2).next_down()
+        };
+        Self {
+            lo,
+            hi: self.lo.abs().max(self.hi.abs()).powi(2).next_up(),
+        }
+    }
+
+    pub(super) fn finite(self) -> bool {
+        self.lo.is_finite() && self.hi.is_finite() && self.lo <= self.hi
+    }
+}
+
+
+impl Interval {
+    pub(super) fn neg(self)->Self {Self{lo:-self.hi,hi:-self.lo}}
+    pub(super) fn div_positive(self,other:Self)->Self {
+        assert!(other.lo>0.);
+        self.mul(Self{lo:(1./other.hi).next_down(),hi:(1./other.lo).next_up()})
+    }
+    pub(super) fn abs_upper(self)->f64 {self.lo.abs().max(self.hi.abs())}
+}
+#[cfg(test)] mod tests {
+    use super::*;
+    #[test] fn arithmetic_encloses_exact_representable_endpoints() {
+        let a=Interval{lo:1.,hi:2.};let b=Interval{lo:-3.,hi:4.};
+        let product=a.mul(b);assert!(product.lo<= -6. && product.hi>=8.);
+        let sum=a.add(b);assert!(sum.lo<= -2. && sum.hi>=6.);
+        let difference=a.sub(b);assert!(difference.lo<= -3. && difference.hi>=5.);
+        let square=b.square();assert!(square.lo<=0. && square.hi>=16.);
+        let quotient=a.div_positive(Interval{lo:2.,hi:4.});assert!(quotient.lo<=0.25 && quotient.hi>=1.);
+    }
+    #[test] fn invalid_and_nonfinite_intervals_cannot_supply_finite_bounds() {
+        assert!(!Interval{lo:2.,hi:1.}.finite());
+        assert!(!Interval{lo:f64::NEG_INFINITY,hi:f64::INFINITY}.finite());
+        assert!(!Interval::point(f64::NAN).finite());
+    }
+}
