+#[cfg(test)] mod cache_tests {
+ use super::*;
+ #[test] fn exact_results_survive_order_and_eviction() {
+  let cache=std::sync::RwLock::new(MembershipCache::new(2));
+  let fixtures=[(-0.1,-0.1,0.2),(-1.05,-0.05,0.1),(0.8,0.5,0.1),(0.24,-0.01,0.02),
+   (0.33125,0.05,1e-7),(f64::NAN,0.,1.),(-0.,0.,0.),(0.,0.,0.)];
+  let expected:Vec<_>=fixtures.iter().map(|&(x,y,w)|membership_uncached(x,y,w)).collect();
+  for index in (0..fixtures.len()).chain((0..fixtures.len()).rev()) {
+   let (x,y,w)=fixtures[index];
+   assert_eq!(membership_using(x,y,w,&cache),expected[index]);
+   assert_eq!(membership_using(x,y,w,&cache),expected[index]);
+   assert!(cache.read().unwrap().map.len()<=2);
+  }
+ }
+}
diff --git a/runtime-core/src/geometry_provider/empty_cache_controls.rs b/runtime-core/src/geometry_provider/empty_cache_controls.rs
new file mode 100644
--- /dev/null
+++ b/runtime-core/src/geometry_provider/empty_cache_controls.rs
@@ -0,0 +1,36 @@
+use super::*;
+
+#[test]
+fn cached_empty_tiles_equal_fresh_membership_and_contour_construction() {
+    let k = 21;
+    let h = dyadic_h(k);
+    let stride = DYADIC_CORE_CELLS as f64 * h;
+    let c = Complex64::new(0.33125, 0.05);
+    let ix = (c.re / stride).floor() as i64;
+    let iy = (c.im / stride).floor() as i64;
+    let mut checked = 0;
+    for dx in [-256, -128, -64, 0, 64, 128, 256] {
+        for dy in [-256, -128, -64, 0, 64, 128, 256] {
+            let x = ix + dx;
+            let y = iy + dy;
+            let re = x as f64 * stride - DYADIC_HALO_CELLS as f64 * h;
+            let im = y as f64 * stride - DYADIC_HALO_CELLS as f64 * h;
+            if uniform_box::membership(re, im, DYADIC_TILE_CELLS as f64 * h).is_some() {
+                continue;
+            }
+            let expected = generate_shore_tile(k, h, re, im).unwrap();
+            if !expected.segments.is_empty() || !expected.unstable_nodes.is_empty() {
+                continue;
+            }
+            let first = get_or_generate_shore_tile(k, x, y).unwrap();
+            let repeated = get_or_generate_shore_tile(k, x, y).unwrap();
+            assert_eq!(format!("{expected:?}"), format!("{first:?}"));
+            assert_eq!(format!("{expected:?}"), format!("{repeated:?}"));
+            let key = TileKey {version: GEOMETRY_PROVIDER_VERSION.into(), k,
+                tile_x: x, tile_y: y, budget: dyadic_n0(k)};
+            assert!(EMPTY_SHORE_TILE_CACHE.write().unwrap().get(&key).is_some());
+            checked += 1;
+        }
+    }
+    assert!(checked > 0);
+}
