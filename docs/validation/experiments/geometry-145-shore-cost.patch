 /// `Some` proves that every point has the same membership. `None` is only a
 /// failed shortcut, never a membership refusal. Outward-rounded intervals may
 /// overestimate the orbit enclosure, which costs work but cannot hide a Shore.
+type MembershipCache = super::LruCache<(u64,u64,u64),Option<bool>>;
+static MEMBERSHIP_CACHE: once_cell::sync::Lazy<std::sync::RwLock<MembershipCache>> =
+    once_cell::sync::Lazy::new(|| std::sync::RwLock::new(MembershipCache::new(16384)));
+
 pub(super) fn membership(re0: f64, im0: f64, width: f64) -> Option<bool> {
+    membership_using(re0,im0,width,&MEMBERSHIP_CACHE)
+}
+fn membership_using(re0:f64,im0:f64,width:f64,cache:&std::sync::RwLock<MembershipCache>)->Option<bool> {
+    let key=(re0.to_bits(),im0.to_bits(),width.to_bits());
+    if let Ok(mut retained)=cache.write() {
+        if let Some(result)=retained.get(&key) {return result;}
+    }
+    let result=membership_uncached(re0,im0,width);
+    if let Ok(mut retained)=cache.write() {retained.insert(key,result);}
+    result
+}
+fn membership_uncached(re0: f64, im0: f64, width: f64) -> Option<bool> {
     if !re0.is_finite() || !im0.is_finite() || !width.is_finite() || width < 0.0 {
         return None;
     }
@@ -402,3 +418,19 @@
   }
